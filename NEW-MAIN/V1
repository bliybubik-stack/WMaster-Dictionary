            if #word > 1 and word:sub(-#sMode) == sMode and not seen[word] then
                table.insert(candidates, word)
                seen[word] = true
            end
        end
    elseif lengthMode > 0 then
        for _, word in ipairs(bucket) do
            if #word == lengthMode and not seen[word] then
                table.insert(candidates, word)
                seen[word] = true
            end
        end
    else
        for _, word in ipairs(bucket) do
            if #word > 1 and not seen[word] then
                table.insert(candidates, word)
                seen[word] = true
            end
        end
    end

    if #candidates == 0 then
        for _, word in ipairs(bucket) do
            if #word > 1 and not seen[word] then
                table.insert(candidates, word)
                seen[word] = true
            end
        end
    end

    -- Sort
    if sortMode == "Shortest" then
        table.sort(candidates, function(a,b) return #a < #b end)
    elseif sortMode == "Longest" then
        table.sort(candidates, function(a,b) return #a > #b end)
    elseif sortMode == "Killer" then
        table.sort(candidates, function(a,b)
            local scoreA = GetKillerScore(a)
            local scoreB = GetKillerScore(b)
            if scoreA ~= scoreB then return scoreA > scoreB end
            return #a < #b
        end)
    else -- Random
        shuffleTable(candidates)
    end

    -- Show top 50
    local limit = math.min(50, #candidates)
    for i = 1, limit do
        local w = candidates[i]
        local btn = Instance.new("TextButton", ScrollList)
        btn.Size = UDim2.new(1, -6, 0, 22)
        btn.BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(25,18,30) or Color3.fromRGB(35,25,40)
        btn.Text = w
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.TextColor3 = THEME.Text
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            SmartType(w, requiredLetter, true, true)
            Tween(btn, {BackgroundColor3 = THEME.Accent}, 0.15)
            task.delay(0.15, function()
                Tween(btn, {BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(25,18,30) or Color3.fromRGB(35,25,40)}, 0.15)
            end)
        end)
        table.insert(ButtonCache, btn)
    end

    ScrollList.CanvasSize = UDim2.new(0, 0, 0, limit * 26 + 10)
end

