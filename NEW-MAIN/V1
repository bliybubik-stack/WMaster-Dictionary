local function RefreshCustomWords()
    for _, c in ipairs(CWScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local queryRaw = CWSearchBox.Text
    local query = (queryRaw == "" or queryRaw == "🔎 Search custom words...") and "" or queryRaw:lower():gsub("[%s%c]+", "")

    local list = Config.CustomWords or {}
    local shownCount = 0

    for i, w in ipairs(list) do
        if query == "" or w:find(query, 1, true) then
            shownCount = shownCount + 1
            local row = Instance.new("Frame", CWScroll)
            row.Size = UDim2.new(1, -6, 0, 26)
            row.BackgroundColor3 = (shownCount % 2 == 0) and Color3.fromRGB(25,18,30) or Color3.fromRGB(35,25,40)
            row.BorderSizePixel = 0
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            local lbl = Instance.new("TextLabel", row)
            lbl.Text = w
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = THEME.Text
            lbl.Size = UDim2.new(1, -30, 1, 0)
            lbl.Position = UDim2.new(0, 8, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local del = Instance.new("TextButton", row)
            del.Text = "✕"
            del.Font = Enum.Font.GothamBold
            del.TextSize = 12
            del.TextColor3 = Color3.fromRGB(255, 80, 80)
            del.Size = UDim2.new(0, 26, 1, 0)
            del.Position = UDim2.new(1, -26, 0, 0)
            del.BackgroundTransparency = 1

            row.MouseButton1Click:Connect(function()
                SmartType(w, lastDetected, true, true)
                Tween(row, {BackgroundColor3 = THEME.Accent}, 0.15)
                task.delay(0.15, function()
                    Tween(row, {BackgroundColor3 = (shownCount % 2 == 0) and Color3.fromRGB(25,18,30) or Color3.fromRGB(35,25,40)}, 0.15)
                end)
            end)

            del.MouseButton1Click:Connect(function()
                table.remove(Config.CustomWords, i)
                SaveConfig()
                Blacklist[w] = true
                RefreshCustomWords()
                ShowToast("💔 Removed: " .. w, "warning")
            end)
        end
    end
    CWScroll.CanvasSize = UDim2.new(0, 0, 0, shownCount * 28)
end

CWSearchBox:GetPropertyChangedSignal("Text"):Connect(RefreshCustomWords)

CWAddBtn.MouseButton1Click:Connect(function()
    local text = CWAddBox.Text
    if text == "" or text == "Add word..." then return end
    text = text:gsub("[%s%c]+", ""):lower()
    if #text < 2 then return end

    if not Config.CustomWords then Config.CustomWords = {} end
    for _, w in ipairs(Config.CustomWords) do
        if w == text then ShowToast("⚠️ Word already exists!", "warning") return end
    end

    local existsInMain = false
    local c = text:sub(1,1)
    if Buckets and Buckets[c] then
        for _, w in ipairs(Buckets[c]) do
            if w == text then existsInMain = true break end
        end
    end

    if existsInMain then
        ShowToast("⚠️ Word already in dictionary!", "warning")
        return
    end

    table.insert(Config.CustomWords, text)
    SaveConfig()
    table.insert(Words, text)
    if c == "" then c = "#" end
    Buckets[c] = Buckets[c] or {}
    table.insert(Buckets[c], text)

    CWAddBox.Text = ""
    CWAddBox:ReleaseFocus()
    RefreshCustomWords()
    ShowToast("💗 Added: " .. text, "success")
end)
