-- ===== WORD FINDING =====
local HardLetterScores = {
    x = 10, z = 9, q = 9, j = 8, v = 6, k = 5, b = 4, f = 3, w = 3,
    y = 2, g = 2, p = 2
}

local function GetKillerScore(word)
    local lastChar = word:sub(-1)
    return HardLetterScores[lastChar] or 0
end

local function getDistance(s1, s2)
    if #s1 == 0 then return #s2 end
    if #s2 == 0 then return #s1 end
    if s1 == s2 then return 0 end
    local matrix = {}
    for i = 0, #s1 do matrix[i] = {[0] = i} end
    for j = 0, #s2 do matrix[0][j] = j end
    for i = 1, #s1 do
        for j = 1, #s2 do
            local cost = (s1:sub(i,i) == s2:sub(j,j)) and 0 or 1
            matrix[i][j] = math.min(matrix[i-1][j]+1, matrix[i][j-1]+1, matrix[i-1][j-1]+cost)
        end
    end
    return matrix[#s1][#s2]
end

local KEY_POS = {}
do
    local row1 = "qwertyuiop"
    local row2 = "asdfghjkl"
    local row3 = "zxcvbnm"
    for i = 1, #row1 do KEY_POS[row1:sub(i,i)] = {x = i, y = 1} end
    for i = 1, #row2 do KEY_POS[row2:sub(i,i)] = {x = i + 0.5, y = 2} end
    for i = 1, #row3 do KEY_POS[row3:sub(i,i)] = {x = i + 1, y = 3} end
end

local function KeyDistance(a, b)
    if not a or not b then return 1 end
    a = a:lower()
    b = b:lower()
    local pa = KEY_POS[a]
    local pb = KEY_POS[b]
    if not pa or not pb then return 1 end
    local dx = pa.x - pb.x
    local dy = pa.y - pb.y
    return math.sqrt(dx*dx + dy*dy)
end

local lastKey = nil

local function CalculateDelayForKeys(prevChar, nextChar)
    if isBlatant then
        return 60 / currentCPM
    end

    local charsPerMin = currentCPM
    local baseDelay = 60 / charsPerMin
    local variance = baseDelay * 0.35
    local extra = 0

    if useHumanization and useFingerModel and prevChar and nextChar and prevChar ~= "" then
        local dist = KeyDistance(prevChar, nextChar)
        extra = dist * 0.018 * (550 / math.max(150, currentCPM))
        local pa = KEY_POS[prevChar:lower()]
        local pb = KEY_POS[nextChar:lower()]
        if pa and pb then
            if (pa.x <= 5 and pb.x <= 5) or (pa.x > 5 and pb.x > 5) then
                extra = extra * 0.8
            end
        end
    end

    if useHumanization then
        local r = (math.random() + math.random() + math.random()) / 3
        local noise = (r * 2 - 1) * variance
        return math.max(0.005, baseDelay + extra + noise)
    else
        return baseDelay
    end
end

local function GetBestWord(requiredLetter, blacklist)
    local startChar = requiredLetter:lower()
    local candidates = {}
    local seen = blacklist or {}

    local bucket = Buckets[startChar] or Buckets["#"]

    if suffixMode ~= "" and suffixMode ~= "---" and suffixMode ~= "..." then
        local sMode = suffixMode:lower():gsub("[%s%c]+", "")
        for _, word in ipairs(bucket) do
            if #word > 1 and word:sub(-#sMode) == sMode and not seen[word] then
                table.insert(candidates, word)
            end
        end
    elseif lengthMode > 0 then
        for _, word in ipairs(bucket) do
            if #word == lengthMode and not seen[word] then
                table.insert(candidates, word)
            end
        end
    else
        for _, word in ipairs(bucket) do
            if #word > 1 and not seen[word] then
                table.insert(candidates, word)
            end
        end
    end

    if #candidates == 0 then
        for _, word in ipairs(bucket) do
            if #word > 1 and not seen[word] then
                table.insert(candidates, word)
            end
        end
    end

    if #candidates == 0 then return nil end

    if sortMode == "Shortest" then
        table.sort(candidates, function(a,b) return #a < #b end)
    elseif sortMode == "Longest" then
        table.sort(candidates, function(a,b) return #a > #b end)
    elseif sortMode == "Killer" then
        table.sort(candidates, function(a,b)
            local scoreA = GetKillerScore(a)
            local scoreB = GetKillerScore(b)
            if scoreA ~= scoreB then return scoreA > scoreB end
            return #a < #b
        end)
    else -- Random
        return candidates[math.random(1, #candidates)]
    end

    return candidates[1]
end

-- ===== SMART TYPING =====
local function SmartType(word, requiredLetter, force, silent)
    if not word or word == "" then return end

    if not silent then
        ShowToast("💗 Typing: " .. word, "success")
    end

    local focused = GetGameTextBox()
    if focused then
        focused:CaptureFocus()
    end

    local wordLower = word:lower()
    local typed = ""
    local errors = 0
    local totalErrors = 0
    local maxErrors = math.max(1, math.floor(#wordLower * (errorRate / 100)))

    local function shouldError()
        if totalErrors >= maxErrors then return false end
        if not riskyMistakes and totalErrors > 3 then return false end
        return math.random() < (errorRate / 120)
    end

    local wordStart = tick()

    for i = 1, #wordLower do
        local currentChar = wordLower:sub(i, i)

        -- Check if the user is typing manually
        if focused and focused.Text ~= typed then
            typed = focused.Text
            isTyping = true
            lastTypingStart = tick()
        end

        -- Error simulation
        if shouldError() then
            local wrongChar
            repeat
                wrongChar = string.char(math.random(97, 122))
            until wrongChar ~= currentChar

            SimulateKey(wrongChar)
            totalErrors = totalErrors + 1
            errors = errors + 1

            if i < #wordLower then
                local delay = CalculateDelayForKeys(currentChar, wordLower:sub(i+1, i+1))
                if useHumanization then delay = delay * (0.8 + math.random() * 0.4) end
                task.wait(delay)
            else
                task.wait(CalculateDelayForKeys(currentChar, ""))
            end

            -- Backspace the error
            Backspace(1)
            task.wait(0.02)
        end

        -- Type the correct character
        SimulateKey(currentChar)
        typed = typed .. currentChar

        if focused then focused.Text = typed end

        local nextChar = (i < #wordLower) and wordLower:sub(i+1, i+1) or ""
        local delay = CalculateDelayForKeys(currentChar, nextChar)

        if useHumanization then
            delay = delay * (0.85 + math.random() * 0.3)
        end

        task.wait(math.max(0.002, delay))

        if focused and focused.Text ~= typed then
            typed = focused.Text
            isTyping = true
            lastTypingStart = tick()
        end
    end

    -- Make sure all text is typed
    if focused and focused.Text ~= wordLower then
        local currentText = focused.Text
        if #currentText < #wordLower then
            for i = #currentText + 1, #wordLower do
                SimulateKey(wordLower:sub(i,i))
                task.wait(CalculateDelayForKeys(wordLower:sub(i-1,i-1), wordLower:sub(i,i)))
            end
        end
    end

    task.wait(0.02)
    PressEnter()

    if not silent then
        StatusText.Text = "💗 Typed: " .. word
        StatusDot.BackgroundColor3 = THEME.Success
        task.delay(1, function()
            StatusText.Text = "💗 Ready..."
            StatusDot.BackgroundColor3 = THEME.SubText
        end)
    end

    Blacklist[word] = true
    UsedWords[word] = true
end

