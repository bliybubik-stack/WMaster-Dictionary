-- ===== MAIN LOOP =====
local function MainLoop()
    local frame = nil
    local player = Players.LocalPlayer
    local gui = player and player:FindFirstChild("PlayerGui")
    local inGame = gui and gui:FindFirstChild("InGame")
    if inGame then
        frame = inGame:FindFirstChild("Frame")
    end

    local word, censored = GetCurrentGameWord(frame)
    local isMyTurn, requiredLetter = GetTurnInfo(frame)

    if isMyTurn and requiredLetter and word == "" and not isTyping then
        local bestWord = GetBestWord(requiredLetter, Blacklist)

        if bestWord then
            lastRequiredLetter = requiredLetter
            currentBestMatch = bestWord

            if autoPlay then
                if isAutoPlayScheduled then return end

                isAutoPlayScheduled = true
                task.delay(thinkDelayCurrent, function()
                    isAutoPlayScheduled = false
                    if not unloaded and isMyTurn and not isTyping then
                        local currentWord, _ = GetCurrentGameWord(frame)
                        if currentWord == "" then
                            SmartType(bestWord, requiredLetter, true, false)
                            lastDetected = bestWord
                            UpdateList(requiredLetter, bestWord)
                        end
                    end
                end)
                return
            end

            UpdateList(requiredLetter, bestWord)
            lastDetected = bestWord
            lastRequiredLetter = requiredLetter
            currentBestMatch = bestWord
            StatusDot.BackgroundColor3 = THEME.Success
            StatusText.Text = "💗 " .. requiredLetter:upper() .. ": " .. bestWord
        else
            StatusDot.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            StatusText.Text = "⚠️ No words found for " .. requiredLetter:upper()
        end
    elseif not isMyTurn and not autoPlay then
        if not word or word == "" then
            -- Idle
        end
    end

    -- Auto join
    if autoJoin and tick() - lastAutoJoinCheck > 0.5 then
        lastAutoJoinCheck = tick()
        local inMenu = gui and gui:FindFirstChild("Menu")
        if inMenu and inMenu.Visible then
            for _, btn in ipairs(inMenu:GetDescendants()) do
                if btn:IsA("TextButton") and btn.Visible then
                    local btnText = btn.Text:lower()
                    local shouldJoin = false

                    if btnText:find("1v1") and Config.AutoJoinSettings._1v1 then shouldJoin = true end
                    if btnText:find("4 player") and Config.AutoJoinSettings._4p then shouldJoin = true end
                    if btnText:find("8 player") and Config.AutoJoinSettings._8p then shouldJoin = true end

                    if shouldJoin then
                        local key = btnText
                        if not JoinDebounce[key] or tick() - JoinDebounce[key] > 10 then
                            JoinDebounce[key] = tick()
                            btn:CaptureFocus()
                            VirtualInputManager:SendMouseButtonEvent(btn.AbsolutePosition.X + btn.AbsoluteSize.X/2, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y/2, 0, true, game, 0)
                            task.wait(0.05)
                            VirtualInputManager:SendMouseButtonEvent(btn.AbsolutePosition.X + btn.AbsoluteSize.X/2, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y/2, 0, false, game, 0)
                            ShowToast("🚀 Joining: " .. btnText, "success")
                            break
                        end
                    end
                end
            end
        end
    end
end

