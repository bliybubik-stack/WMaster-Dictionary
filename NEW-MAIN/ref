local function LoadLocalDictionary(filename)
    local success, content = pcall(function()
        return game:HttpGet("rbxassetid://" .. filename) -- Try loading from asset
    end)
    
    if not success then
        -- Try loading directly from file path
        success, content = pcall(function()
            return readfile(filename)
        end)
    end
    
    if not success then
        return nil
    end
    
    local words = {}
    local lineNum = 0
    for line in content:gmatch("[^\r\n]+") do
        lineNum = lineNum + 1
        -- Skip lines that start with '[' (like [UPDATE: 50], [WARNING], etc.)
        if not string.match(line, "^%[") then
            local word = line:gsub("%s+", ""):lower()
            if word:match("^[a-z]+$") and #word >= 2 and #word <= 20 then
                words[word] = true
            end
        end
    end
    
    return words
end

