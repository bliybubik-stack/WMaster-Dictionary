local function UpdateSuggestions()
    if not isInitialized or #filteredDictionary == 0 then
        if not isInitialized then
            statusLabel.Text = "loading dictionaries kollega"
        end
        return
    end
    
    local requiredLetter = GetRequiredLetter()
    local searchPrefix = ""
    local currentWord = GetCurrentWord()
    
    if currentWord and #currentWord > 0 then
        searchPrefix = currentWord
    elseif requiredLetter and #requiredLetter > 0 then
        searchPrefix = requiredLetter
    else
        for _, btn in ipairs(suggestionButtons) do
            btn.Visible = false
        end
        if wordCounter > 0 then
            statusLabel.Text = "ready - type or wait for letter"
        else
            statusLabel.Text = "ready - type or wait for letter"
        end
        prefixValue.Text = "..."
        wordCountLabel.Text = #filteredDictionary .. " words"
        return
    end
    
    prefixValue.Text = '"' .. searchPrefix .. '"'
    
    local suggestions = GetSuggestions(searchPrefix)
    
    for i, btn in ipairs(suggestionButtons) do
        if suggestions[i] then
            btn.Text = FormatSuggestionText(suggestions[i], searchPrefix)
            btn.Visible = true
        else
            btn.Visible = false
        end
    end
    
    local visibleCount = 0
    for _, btn in ipairs(suggestionButtons) do
        if btn.Visible then visibleCount = visibleCount + 1 end
    end
    suggestionsFrame.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 32 + 10)
    
    if #suggestions > 0 then
        statusLabel.Text = "found " .. #suggestions .. " words"
    else
        statusLabel.Text = "no new words for '" .. searchPrefix .. "'"
    end
    wordCountLabel.Text = #filteredDictionary .. " words"
end

local function SetupTriggers()
    local inGameGui = parent:FindFirstChild("InGame")
    if not inGameGui then
        parent.ChildAdded:Connect(function(c)
            if c.Name == "InGame" then SetupTriggers() end
        end)
        return
    end
    
    local frame = inGameGui:FindFirstChild("Frame")
    if not frame then return end
    
    local wordFrame = frame:FindFirstChild("CurrentWord")
    if wordFrame then
        wordFrame.ChildAdded:Connect(function() task.wait(0.05) UpdateSuggestions() end)
        wordFrame.ChildRemoved:Connect(function() task.wait(0.05) UpdateSuggestions() end)
    end
    
    local box = frame:FindFirstChild("TextBox") or frame:FindFirstChild("AnswerBox") or frame:FindFirstChild("ChatInput")
    if box and box:IsA("TextBox") then
        box:GetPropertyChangedSignal("Text"):Connect(UpdateSuggestions)
    end
    
    task.spawn(function()
        while true do
            task.wait(0.5)
            if isInitialized then UpdateSuggestions() end
        end
    end)
end

SetupTriggers()
