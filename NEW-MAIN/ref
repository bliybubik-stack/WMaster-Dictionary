        return roasts[math.random(1, #roasts)]
    end
    
    if wordCounter > 0 and #responses > 0 then
        return responses[math.random(1, #responses)]
    end
    
    return "good word kollega"
end

local function TypeWordHuman(word)
    local inGameGui = parent:FindFirstChild("InGame")
    if not inGameGui then return end
    
    local frame = inGameGui:FindFirstChild("Frame")
    if not frame then return end
    
    local answerBox = frame:FindFirstChild("TextBox") or 
                      frame:FindFirstChild("AnswerBox") or
                      frame:FindFirstChild("Input") or
                      frame:FindFirstChild("ChatInput")
    
    if not answerBox or not answerBox:IsA("TextBox") then
        for i = 1, #word do
            local char = string.sub(word, i, i):lower()
            local keyCode = Enum.KeyCode[char:upper()]
            if keyCode then
                VirtualInput:SendKeyEvent(keyCode, true, false)
                HumanDelay()
                VirtualInput:SendKeyEvent(keyCode, false, false)
                if i < #word then HumanDelay() end
            end
        end
        task.wait(0.05)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)
        return
    end
    
    answerBox:CaptureFocus()
    task.wait(0.05)
    answerBox.Text = ""
    task.wait(0.05)
    
    for i = 1, #word do
        local char = string.sub(word, i, i)
        local typo = SimulateTypo(word)
        
        if typo and typo.position == i then
            answerBox.Text = answerBox.Text .. typo.wrongLetter
            HumanDelay()
            task.wait(GetTypingDelay() / 1000 * 0.4)
            VirtualInput:SendKeyEvent(Enum.KeyCode.Backspace, true, false)
            task.wait(0.04)
            VirtualInput:SendKeyEvent(Enum.KeyCode.Backspace, false, false)
            HumanDelay()
            answerBox.Text = answerBox.Text .. typo.correctLetter
        else
            answerBox.Text = answerBox.Text .. char
        end
        HumanDelay()
    end
    
    task.wait(GetTypingDelay() / 1000 * 0.6)
    VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)
    task.wait(0.03)
    VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)
    task.wait(0.03)
    answerBox:ReleaseFocus()
end

local function TypeWordFast(word)
    local inGameGui = parent:FindFirstChild("InGame")
    if not inGameGui then return end
    
    local frame = inGameGui:FindFirstChild("Frame")
    if not frame then return end
    
    local answerBox = frame:FindFirstChild("TextBox") or 
                      frame:FindFirstChild("AnswerBox") or
                      frame:FindFirstChild("Input") or
                      frame:FindFirstChild("ChatInput")
    
    if answerBox and answerBox:IsA("TextBox") then
        answerBox:CaptureFocus()
        task.wait(0.03)
        answerBox.Text = word
        task.wait(0.03)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)
        answerBox:ReleaseFocus()
    else
        for i = 1, #word do
            local char = string.sub(word, i, i):lower()
            local keyCode = Enum.KeyCode[char:upper()]
            if keyCode then
                VirtualInput:SendKeyEvent(keyCode, true, false)
                task.wait(0.008)
                VirtualInput:SendKeyEvent(keyCode, false, false)
            end
        end
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)
    end
end

local function TypeWord(word)
    local cleanWord = word:lower()
    lastSubmittedWord = cleanWord
    
    if not usedWords[cleanWord] then
        wordCounter = wordCounter + 1
        table.insert(submittedWords, cleanWord)
        
        local response = GetRandomResponse()
        statusLabel.Text = '"' .. cleanWord .. '" - ' .. response
    end
    
    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end
    
    usedWords[cleanWord] = true
    UpdateFilteredDictionary()
    UpdateSuggestions()
end

local function IsKillerWord(word)
    local lowerWord = word:lower()
    for _, ending in ipairs(hardEndings) do
        if #ending <= #lowerWord and string.sub(lowerWord, -#ending) == ending then
            return true
        end
    end
    return false
end

local function FilterWordsByMode()
    if settings.wordFilter == "all" then
        local filtered = {}
        for _, word in ipairs(dictionary) do
            if not usedWords[word] then
                table.insert(filtered, word)
            end
        end
        return filtered
    end
    
    local filtered = {}
    local category = lengthCategories[settings.wordFilter]
    
    for _, word in ipairs(dictionary) do
        if not usedWords[word] then
            local wordLen = #word
            if settings.wordFilter == "killer" then
                if IsKillerWord(word) and wordLen >= 3 then
                    table.insert(filtered, word)
                end
            elseif wordLen >= category.min and wordLen <= category.max then
                table.insert(filtered, word)
            end
        end
    end
    
    return filtered
end

local function UpdateFilteredDictionary()
    filteredDictionary = FilterWordsByMode()
    prefixCache = {}
    if isInitialized then
        UpdateSuggestions()
    end
end

local function GetCurrentWord()
    local inGameGui = parent:FindFirstChild("InGame")
    if not inGameGui then return "" end
    
    local frame = inGameGui:FindFirstChild("Frame")
    if not frame then return "" end
    
    local currentWordFrame = frame:FindFirstChild("CurrentWord")
    if currentWordFrame and currentWordFrame.Visible then
        local letters = {}
        local numbered = {}
        
        for _, child in ipairs(currentWordFrame:GetChildren()) do
            local idx = tonumber(child.Name)
            if idx and child:FindFirstChild("Letter") then
                table.insert(numbered, {idx = idx, obj = child})
            end
        end
        
        table.sort(numbered, function(a, b) return a.idx < b.idx end)
        for _, entry in ipairs(numbered) do
            local letter = entry.obj.Letter.Text
            if type(letter) == "string" and letter ~= "" then
                table.insert(letters, letter)
            end
        end
        
        if #letters > 0 then
            return table.concat(letters):lower()
        end
    end
    
    local wordLabel = frame:FindFirstChild("WordLabel") or 
                      frame:FindFirstChild("CurrentWordLabel") or
                      frame:FindFirstChild("WordDisplay")
    if wordLabel and wordLabel:IsA("TextLabel") and wordLabel.Text ~= "" then
        return wordLabel.Text:lower()
    end
    
    local answerBox = frame:FindFirstChild("TextBox") or 
                      frame:FindFirstChild("AnswerBox") or
                      frame:FindFirstChild("ChatInput")
    if answerBox and answerBox:IsA("TextBox") and answerBox.Text ~= "" then
        return answerBox.Text:lower()
    end
    
    return ""
end

local function GetRequiredLetter()
    local inGameGui = parent:FindFirstChild("InGame")
    if not inGameGui then return nil end
    
    local frame = inGameGui:FindFirstChild("Frame")
    if not frame then return nil end
    
    local requirementLabel = frame:FindFirstChild("Requirement") or
                             frame:FindFirstChild("RequiredLetter") or
                             frame:FindFirstChild("NextLetter")
    
    if requirementLabel and requirementLabel:IsA("TextLabel") then
        local text = requirementLabel.Text
        local match = string.match(text, "([A-Za-z])")
        if match then return match:lower() end
    end
    
    local wordLabel = frame:FindFirstChild("LastWord") or 
                      frame:FindFirstChild("PreviousWord")
    if wordLabel and wordLabel:IsA("TextLabel") then
        local word = wordLabel.Text
        if #word > 0 then
            local lastChar = string.sub(word, -1):lower()
            if string.match(lastChar, "%a") then
                return lastChar
            end
        end
    end
    
    return nil
end

local function FindWordRange(prefix)
    local low, high = 1, #filteredDictionary
    local startIdx, endIdx
    
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if filteredDictionary[mid]:sub(1, #prefix) < prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end
    startIdx = low
    
    low, high = startIdx, #filteredDictionary
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if filteredDictionary[mid]:sub(1, #prefix) == prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end
    endIdx = high
    
    if startIdx > endIdx then
        return nil, nil
    end
    return startIdx, endIdx
end

local function GetSuggestions(prefix)
    prefix = prefix:lower()
    if #prefix == 0 then return {} end
    
    local suggestions = {}
    local range = prefixCache[prefix]
    local sIdx, eIdx
    
    if range then
        sIdx, eIdx = range[1], range[2]
    else
        sIdx, eIdx = FindWordRange(prefix)
        if sIdx then
            prefixCache[prefix] = {sIdx, eIdx}
            local cacheCount = 0
            for _ in pairs(prefixCache) do
                cacheCount = cacheCount + 1
                if cacheCount > 50 then
                    prefixCache = {}
                    break
                end
            end
        end
    end
    
    if not sIdx then return {} end
    
    for i = sIdx, math.min(sIdx + SUGGESTION_COUNT * 3, eIdx) do
        local word = filteredDictionary[i]
        if word and #suggestions < SUGGESTION_COUNT and word ~= prefix then
            if word:match("^[a-z]+$") and #word >= 3 then
                table.insert(suggestions, word)
            end
        end
    end
    
    return suggestions
end

local function FormatSuggestionText(word, currentPrefix)
    if not currentPrefix or #currentPrefix == 0 then
        return word
    end
    
    local prefix = currentPrefix:lower()
    local lowerWord = word:lower()
    
    if string.sub(lowerWord, 1, #prefix) == prefix then
        local typedPart = string.sub(word, 1, #prefix)
        local remainingPart = string.sub(word, #prefix + 1)
        return '<font color="#FF1493">' .. typedPart .. '</font>' .. remainingPart
    end
    
    return word
end

