local function LoadDictionaryFromJSON(url)
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)
    
    if not success then
        return nil
    end
    
    local data
    local ok = pcall(function()
        data = HttpService:JSONDecode(content)
    end)
    
    if not ok or type(data) ~= "table" then
        return nil
    end
    
    local words = {}
    for word in pairs(data) do
        if word:match("^[a-zA-Z]+$") and #word >= 3 and #word <= 20 then
            words[word:lower()] = true
        end
    end
    
    return words
end

local function LoadDictionaryFromTXT(url)
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)
    
    if not success then
        return nil
    end
    
    local words = {}
    for line in content:gmatch("[^\r\n]+") do
        local word = line:gsub("%s+", ""):lower()
        if word:match("^[a-z]+$") and #word >= 3 and #word <= 20 then
            words[word] = true
        end
    end
    
    return words
end

