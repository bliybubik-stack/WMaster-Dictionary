        end
    end)

    settingsTitleBar.InputEnded:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            draggingSettings = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)

        if not draggingSettings then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            local delta =
                input.Position -
                settingsDragStart

            settingsFrame.Position =
                UDim2.new(
                    settingsStartPosition.X.Scale,
                    settingsStartPosition.X.Offset + delta.X,

                    settingsStartPosition.Y.Scale,
                    settingsStartPosition.Y.Offset + delta.Y
                )
        end
    end)

    --====================================================
    -- OPEN SETTINGS
    --====================================================

    settingsBtn.MouseButton1Click:Connect(function()

        settingsFrame.Visible =
            not settingsFrame.Visible
    end)

    closeSettingsBtn.MouseButton1Click:Connect(function()

        settingsFrame.Visible =
            false
    end)
end

--========================================================
-- UPDATE SUGGESTIONS
--========================================================

function UpdateSuggestions()

    if not isInitialized
        or #filteredDictionary == 0 then

        if statusLabel then
            statusLabel.Text =
                "loading..."
        end

        return
    end

    local requiredLetter =
        GetRequiredLetter()

    local currentWord =
        GetCurrentWord()

    local searchPrefix = ""

    if currentWord
        and #currentWord > 0 then

        searchPrefix =
            currentWord

    elseif requiredLetter
        and #requiredLetter > 0 then

        searchPrefix =
            requiredLetter

    else

        for _, btn in
            ipairs(suggestionButtons) do

            btn.Visible =
                false
        end

        if statusLabel then
            statusLabel.Text =
                "ready"
        end

        if prefixValue then
            prefixValue.Text =
                "..."
        end

        if wordCountLabel then
            wordCountLabel.Text =
                #filteredDictionary ..
                " words"
        end

        return
    end

    searchPrefix =
        searchPrefix:lower()

    prefixValue.Text =
        '"' ..
        searchPrefix ..
        '"'

    local suggestions =
        GetSuggestions(
            searchPrefix
        )

    --====================================================
    -- DISPLAY
    --====================================================

    for i, btn in
        ipairs(suggestionButtons) do

        local word =
            suggestions[i]

        if word
            and not usedWords[word] then

            -- Save actual word.
            btn:SetAttribute(
                "Word",
                word
            )

            -- No markup needed now.
            btn.Text =
                word

            btn.Visible =
                true

        else

            btn:SetAttribute(
                "Word",
                nil
            )

            btn.Text =
                ""

            btn.Visible =
                false
        end
    end

    local visibleCount = 0

    for _, btn in
        ipairs(suggestionButtons) do

        if btn.Visible then
            visibleCount += 1
        end
    end

    suggestionsFrame.CanvasSize =
        UDim2.new(
            0,
            0,
            0,
            visibleCount * 31 + 5
        )

    if #suggestions > 0 then

        statusLabel.Text =
            "found " ..
            #suggestions ..
            " words"

    else

        statusLabel.Text =
            "no new words"
    end

    wordCountLabel.Text =
        #filteredDictionary ..
        " words"
end

--========================================================
-- AUTO PLAY
--========================================================

function AutoPlayLoop()

    while isAutoPlaying
        and isInitialized do

        task.wait(
            settings.autoPlayDelay
        )

        local requiredLetter =
            GetRequiredLetter()

        local currentWord =
            GetCurrentWord()

        local searchPrefix = ""

        if currentWord
            and #currentWord > 0 then

            searchPrefix =
                currentWord

        elseif requiredLetter
            and #requiredLetter > 0 then

            searchPrefix =
                requiredLetter

        else

            continue
        end

        local suggestions =
            GetSuggestions(
                searchPrefix
            )

        if #suggestions > 0 then

            local word =
                suggestions[
                    math.random(
                        1,
                        #suggestions
                    )
                ]

            if word
                and not usedWords[word] then

                TypeWord(word)
            end
        end
    end
end

--========================================================
-- DICTIONARY LOADING
--========================================================

local function LoadDictionaryFromTXT(url)

    local success, content =
        pcall(function()

            return game:HttpGet(
                url
            )
        end)

    if not success then
        return nil, 0
    end

    local words = {}
    local count = 0

    for line in
        content:gmatch(
            "[^\r\n]+"
        ) do

        local word =
            line:gsub(
                "%s+",
                ""
            ):lower()

        if word:match(
            "^[a-z]+$"
        )
            and #word >= 3
            and #word <= 20 then

            if not words[word] then

                words[word] =
                    true

                count += 1
            end
        end
    end

    return words, count
end

local function LoadDictionaryFromJSON(url)

    local success, content =
        pcall(function()

            return game:HttpGet(
                url
            )
        end)

    if not success then
        return nil, 0
    end

    local data

    local ok =
        pcall(function()

            data =
                HttpService:JSONDecode(
                    content
                )
        end)

    if not ok
        or type(data) ~= "table" then

        return nil, 0
    end

    local words = {}
    local count = 0

    for word in pairs(data) do

        if word:match(
            "^[a-zA-Z]+$"
        )
            and #word >= 3
            and #word <= 20 then

            local clean =
                word:lower()

            if not words[clean] then

                words[clean] =
                    true

                count += 1
            end
        end
    end

    return words, count
end

local function LoadAllDictionaries()

    local wordMap = {}
    local totalWords = 0

    for _, source in
        ipairs(DICTIONARY_SOURCES) do

        local words
        local count = 0

        if source.type == "txt" then

            words, count =
                LoadDictionaryFromTXT(
                    source.url
                )

        elseif source.type == "json" then

            words, count =
                LoadDictionaryFromJSON(
                    source.url
                )
        end

        if words
            and count > 0 then

            local newWords = 0

            for word in pairs(words) do

                if not wordMap[word] then

                    wordMap[word] =
                        true

                    newWords += 1
                end
            end

            totalWords +=
                newWords

            source.loaded =
                true
        end
    end

    if totalWords == 0 then

        local fallback = {

            "apple",
            "ant",
            "art",
            "able",
            "about",
            "accept",
            "act",
            "add",
            "after",
            "again",
            "age",
            "all",
            "allow",
            "almost",
            "alone",
            "along",
            "already",
            "also",
            "always",
            "amaze",
            "among",
            "amount",
            "ancient",
            "anger",
            "angle",
            "another",
            "answer",
            "any",
            "apart",
            "appear",
            "apply",
            "area",
            "argue",
            "arm",
            "around",
            "arrive",
            "ask",
            "attention",
            "away",
            "baby",
            "back",
            "bad",
            "bag",
            "ball",
            "band",
            "bank",
            "bar",
            "base",
            "basic"
        }

        for _, w in
            ipairs(fallback) do

            if not wordMap[w] then

                wordMap[w] =
                    true

                totalWords += 1
            end
        end
    end

    dictionary = {}

    for word in
        pairs(wordMap) do

        table.insert(
            dictionary,
            word
        )
    end

    table.sort(
        dictionary
    )

    filteredDictionary =
        FilterWordsByMode()

    isInitialized =
        true

    return totalWords
end

