    -- ========================================================
    -- SUGGESTION UPDATER
    -- ========================================================

    local function UpdateSuggestions()

        if not isInitialized
            or #filteredDictionary == 0 then

            statusLabel.Text =
                "LOADING..."

            return
        end

        local requiredLetter =
            GetRequiredLetter()

        local searchPrefix = ""

        local currentWord =
            GetCurrentWord()

        if currentWord
            and #currentWord > 0 then

            searchPrefix =
                currentWord

        elseif requiredLetter
            and #requiredLetter > 0 then

            searchPrefix =
                requiredLetter

        else

            for _, data in ipairs(
                suggestionButtons
            ) do
                data.button.Visible = false
            end

            statusLabel.Text =
                "READY"

            prefixValue.Text =
                "..."

            wordCountLabel.Text =
                #filteredDictionary
                .. " words"

            return
        end

        prefixValue.Text =
            '"' ..
            searchPrefix ..
            '"'

        local suggestions =
            GetSuggestions(
                searchPrefix
            )

        for i, data in ipairs(
            suggestionButtons
        ) do

            local word =
                suggestions[i]

            if word then

                local formatted =
                    FormatSuggestionText(
                        word,
                        searchPrefix
                    )

                if formatted ~= "" then

                    data.label.Text =
                        formatted

                    data.button:SetAttribute(
                        "Word",
                        word
                    )

                    data.button.Visible = true

                else
                    data.button.Visible = false
                end

            else
                data.button.Visible = false
            end
        end

        local visibleCount = 0

        for _, data in ipairs(
            suggestionButtons
        ) do
            if data.button.Visible then
                visibleCount =
                    visibleCount + 1
            end
        end

        suggestionsFrame.CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                visibleCount * 39
            )

        if #suggestions > 0 then

            statusLabel.Text =
                "FOUND "
                .. #suggestions
                .. " WORDS"

        else

            statusLabel.Text =
                "NO MATCHES"
        end

        wordCountLabel.Text =
            #filteredDictionary
            .. " words"

        rightInfo.Text =
            tostring(
                #filteredDictionary
            )
            .. " WORDS AVAILABLE"
    end

    -- IMPORTANT:
    -- expose the updater so the unchanged core functions
    -- can refresh the new GUI without altering their behavior.

    _G.WordGangUpdateSuggestions =
