            Enum.Font.GothamBold

        btn.Parent =
            settingsContent

        StyleButton(btn)

        local state =
            initial

        local function Refresh()

            btn.Text =
                state and
                "ON" or
                "OFF"

            btn.TextColor3 =
                state and
                COLORS.text or
                COLORS.textMuted

            btn.BackgroundColor3 =
                state and
                COLORS.glass2 or
                COLORS.button
        end

        Refresh()

        btn.MouseButton1Click:Connect(function()

            state =
                not state

            callback(state)

            Refresh()
        end)

        return btn
    end

