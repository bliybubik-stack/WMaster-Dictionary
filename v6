local function LoadDictionaryFromTXT(url)
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)

    if not success then
        return nil, 0
    end

    local words = {}
    local count = 0

    for line in content:gmatch("[^\r\n]+") do
        local word = line:gsub("%s+", ""):lower()

        if word:match("^[a-z]+$")
            and #word >= 3
            and #word <= 20 then

            if not words[word] then
                words[word] = true
                count = count + 1
            end
        end
    end

    return words, count
end

local function LoadDictionaryFromJSON(url)
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)

    if not success then
        return nil, 0
    end

    local data

    local ok = pcall(function()
        data = HttpService:JSONDecode(content)
    end)

    if not ok or type(data) ~= "table" then
        return nil, 0
    end

    local words = {}
    local count = 0

    for word in pairs(data) do
        if word:match("^[a-zA-Z]+$")
            and #word >= 3
            and #word <= 20 then

            local clean = word:lower()

            if not words[clean] then
                words[clean] = true
                count = count + 1
            end
        end
    end

    return words, count
end

local function LoadAllDictionaries()
    local wordMap = {}
    local totalWords = 0

    for _, source in ipairs(DICTIONARY_SOURCES) do
        local words, count = nil, 0

        if source.type == "txt" then
            words, count = LoadDictionaryFromTXT(source.url)
        elseif source.type == "json" then
            words, count = LoadDictionaryFromJSON(source.url)
        end

        if words and count > 0 then
            local newWords = 0

            for word in pairs(words) do
                if not wordMap[word] then
                    wordMap[word] = true
                    newWords = newWords + 1
                end
            end

            totalWords = totalWords + newWords
            source.loaded = true
        end
    end

    if totalWords == 0 then
        local fallback = {
            "apple","ant","art","able","about","accept","act","add",
            "after","again","age","all","allow","almost","alone",
            "along","already","also","always","amaze","among",
            "amount","ancient","anger","angle","another","answer",
            "any","apart","appear","apply","area","argue","arm",
            "around","arrive","ask","attention","away","baby",
            "back","bad","bag","ball","band","bank","bar","base",
            "basic"
        }

        for _, w in ipairs(fallback) do
            wordMap[w] = true
            totalWords = totalWords + 1
        end
    end

    dictionary = {}

    for word in pairs(wordMap) do
        table.insert(dictionary, word)
    end

    table.sort(dictionary)

    filteredDictionary = FilterWordsByMode()

    isInitialized = true

    return totalWords
end

-- ============================================================
-- AUTO PLAY
-- ============================================================

local function AutoPlayLoop()
    while isAutoPlaying and isInitialized do
        task.wait(settings.autoPlayDelay)

        local requiredLetter = GetRequiredLetter()
        local currentWord = GetCurrentWord()

        local searchPrefix = ""

        if currentWord and #currentWord > 0 then
            searchPrefix = currentWord

        elseif requiredLetter and #requiredLetter > 0 then
            searchPrefix = requiredLetter
        else
            continue
        end

        local suggestions = GetSuggestions(searchPrefix)

        if #suggestions > 0 then
            local word =
                suggestions[math.random(1, #suggestions)]

            if word then
                TypeWord(word)
            end
        end
    end
end

