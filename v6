        corner(badge, 5)

        ------------------------------------------------------------
        -- HOVER
        ------------------------------------------------------------

        button.MouseEnter:Connect(function()
            tween(button, {
                BackgroundColor3 = UI.Glass3
            }, 0.12)

            tween(buttonStroke, {
                Color = UI.LineBright,
                Transparency = 0
            }, 0.12)

            tween(number, {
                TextColor3 = UI.White
            }, 0.12)
        end)

