    ----------------------------------------------------------------
    -- LIVE UPDATE FUNCTION
    ----------------------------------------------------------------

    local function UpdateSuggestionUI()

        if not isInitialized then
            statusLabel.Text = "LOADING"
            statusSub.Text = "Loading dictionary..."
            return
        end

        local requiredLetter = GetRequiredLetter()
        local currentWord = GetCurrentWord()

        local searchPrefix = ""

        if currentWord and #currentWord > 0 then
            searchPrefix = currentWord
        elseif requiredLetter and #requiredLetter > 0 then
            searchPrefix = requiredLetter
        end

        ------------------------------------------------------------
        -- REQUIRED LETTER
        ------------------------------------------------------------

        requiredValue.Text = requiredLetter
            and string.upper(requiredLetter)
            or "—"

        ------------------------------------------------------------
        -- PREFIX
        ------------------------------------------------------------

        if searchPrefix ~= "" then
            prefixValue.Text = '"' .. searchPrefix .. '"'
        else
            prefixValue.Text = "..."
        end

        ------------------------------------------------------------
        -- SUGGESTIONS
        ------------------------------------------------------------

        local suggestions = {}

        if searchPrefix ~= "" then
            suggestions = GetSuggestions(searchPrefix)
        end

        local visibleCount = 0

        for i = 1, SUGGESTION_COUNT do

            local card = suggestionButtons[i]

            if suggestions[i] then

                local word = suggestions[i]
                local clean = word:gsub("<[^>]+>", "")

                card.button:SetAttribute(
                    "Word",
                    clean
                )

                card.word.Text = FormatSuggestionText(
                    word,
                    searchPrefix
                )

                card.length.Text =
                    tostring(#clean) .. "L"

                if usedWords[clean:lower()] then
                    card.badge.Text = "USED"
                    card.badge.TextColor3 = UI.Gray2
                elseif IsKillerWord(clean) then
                    card.badge.Text = "KILLER"
                    card.badge.TextColor3 = UI.White
                else
                    card.badge.Text = "NEW"
                    card.badge.TextColor3 = UI.Gray
                end

                card.button.Visible = true

                visibleCount += 1

            else

                card.button.Visible = false

            end
        end

        suggestionCount.Text =
            tostring(visibleCount) .. " / " .. tostring(SUGGESTION_COUNT)

        ------------------------------------------------------------
        -- STATUS
        ------------------------------------------------------------

        if searchPrefix == "" then

            statusLabel.Text = "READY"
            statusSub.Text = "Waiting for a round..."

        elseif visibleCount > 0 then

            statusLabel.Text = "FOUND " .. tostring(visibleCount)
            statusSub.Text = "Suggestions available"

        else

            statusLabel.Text = "NO MATCHES"
            statusSub.Text = "No unused words found"

        end

        ------------------------------------------------------------
        -- WORD COUNT
        ------------------------------------------------------------

        wordCountLabel.Text =
            tostring(#filteredDictionary) .. " WORDS"

    end

