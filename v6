local function GetTypingDelay()
    local wpm = math.min(settings.wpm, 700)

    local lettersPerSecond =
        (wpm * 5) / 60

    local baseDelay =
        1 / lettersPerSecond

    return baseDelay * 1000
end

local function HumanDelay()
    if not settings.humanMode then
        return
    end

    local baseDelay = GetTypingDelay()

    local variance =
        baseDelay *
        (math.random(-35, 35) / 100)

    local actualDelay =
        math.max(
            8,
            baseDelay + variance
        )

    task.wait(actualDelay / 1000)
end

local function SimulateTypo(word)

    if settings.riskyMistakes then

        if math.random(1, 100) >
            settings.mistakeChance * 1.5 then

            return nil
        end

    else

        if math.random(1, 100) >
            settings.mistakeChance then

            return nil
        end
    end

    if #word < 4 then
        return nil
    end

    local position =
        math.random(1, #word)

    local wrongLetter =
        string.char(
            math.random(97, 122)
        )

    local correctLetter =
        string.sub(
            word,
            position,
            position
        )

    return {
        position = position,
        wrongLetter = wrongLetter,
        correctLetter = correctLetter
    }
end

local function GetAnswerBox()

    local inGameGui =
        parent:FindFirstChild("InGame")

    if not inGameGui then
        return nil
    end

    local frame =
        inGameGui:FindFirstChild("Frame")

    if not frame then
        return nil
    end

    local answerBox =
        frame:FindFirstChild("TextBox")
        or frame:FindFirstChild("AnswerBox")
        or frame:FindFirstChild("Input")
        or frame:FindFirstChild("ChatInput")

    if answerBox and answerBox:IsA("TextBox") then
        return answerBox
    end

    return nil
end

local function TypeWordHuman(word)

    local inGameGui =
        parent:FindFirstChild("InGame")

    if not inGameGui then
        return
    end

    local frame =
        inGameGui:FindFirstChild("Frame")

    if not frame then
        return
    end

    local answerBox =
        GetAnswerBox()

    if not answerBox then

        for i = 1, #word do

            local char =
                string.sub(
                    word,
                    i,
                    i
                ):lower()

            local keyCode =
                Enum.KeyCode[
                    char:upper()
                ]

            if keyCode then

                VirtualInput:SendKeyEvent(
                    keyCode,
                    true,
                    false
                )

                HumanDelay()

                VirtualInput:SendKeyEvent(
                    keyCode,
                    false,
                    false
                )

                if i < #word then
                    HumanDelay()
                end
            end
        end

        task.wait(0.05)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )

        return
    end

    answerBox:CaptureFocus()

    task.wait(0.05)

    answerBox.Text = ""

    task.wait(0.05)

    for i = 1, #word do

        local char =
            string.sub(
                word,
                i,
                i
            )

        local typo =
            SimulateTypo(word)

        if typo and
            typo.position == i then

            answerBox.Text =
                answerBox.Text ..
                typo.wrongLetter

            HumanDelay()

            task.wait(
                GetTypingDelay() /
                1000 *
                0.4
            )

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                true,
                false
            )

            task.wait(0.04)

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                false,
                false
            )

            HumanDelay()

            answerBox.Text =
                answerBox.Text ..
                typo.correctLetter

        else

            answerBox.Text =
                answerBox.Text ..
                char
        end

        HumanDelay()
    end

    task.wait(
        GetTypingDelay() /
        1000 *
        0.6
    )

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        true,
        false
    )

    task.wait(0.03)

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        false,
        false
    )

    task.wait(0.03)

    answerBox:ReleaseFocus()
end

local function TypeWordFast(word)

    local answerBox =
        GetAnswerBox()

    if answerBox then

        answerBox:CaptureFocus()

        task.wait(0.03)

        answerBox.Text = word

        task.wait(0.03)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )

        answerBox:ReleaseFocus()

        return
    end

    for i = 1, #word do

        local char =
            string.sub(
                word,
                i,
                i
            ):lower()

        local keyCode =
            Enum.KeyCode[
                char:upper()
            ]

        if keyCode then

            VirtualInput:SendKeyEvent(
                keyCode,
                true,
                false
            )

            if settings.blatant then
                task.wait(0.005)
            else
                task.wait(0.008)
            end

            VirtualInput:SendKeyEvent(
                keyCode,
                false,
                false
            )
        end
    end

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        true,
        false
    )

    task.wait(0.02)

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        false,
        false
    )
end

--========================================================
-- DICTIONARY
--========================================================

local function IsKillerWord(word)

    local lowerWord =
        word:lower()

    for _, ending in
        ipairs(hardEndings) do

        if #ending <= #lowerWord
            and string.sub(
                lowerWord,
                -#ending
            ) == ending then

            return true
        end
    end

    return false
end

local function FilterWordsByMode()

    local filtered = {}

    local minLen =
        settings.minWordLength or 3

    local maxLen =
        settings.maxWordLength or 20

    for _, word in
        ipairs(dictionary) do

        local wordLen =
            #word

        if wordLen >= minLen
            and wordLen <= maxLen then

            -- USED WORDS ARE ALWAYS HIDDEN
            if not usedWords[word] then

                if settings.wordFilter == "all" then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "short"
                    and wordLen >= 3
                    and wordLen <= 5 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "middle"
                    and wordLen >= 6
                    and wordLen <= 9 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "long"
                    and wordLen >= 10
                    and wordLen <= 20 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "killer"
                    and IsKillerWord(word)
                    and wordLen >= 3 then

                    table.insert(
                        filtered,
                        word
                    )
                end
            end
        end
    end

    if settings.priorityMode == "speed" then

        table.sort(
            filtered,
            function(a, b)
                return #a < #b
            end
        )

    elseif settings.priorityMode == "killer" then

        table.sort(
            filtered,
            function(a, b)

                local scoreA =
                    IsKillerWord(a) and 1 or 0

                local scoreB =
                    IsKillerWord(b) and 1 or 0

                return scoreA > scoreB
            end
        )
    end

    return filtered
end

local function UpdateFilteredDictionary()

    filteredDictionary =
        FilterWordsByMode()

    prefixCache = {}

    -- Reset active suggestion pool.
    activeSuggestionPrefix = ""
    activeSuggestionPool = {}

    if isInitialized then
        task.defer(function()
            if UpdateSuggestions then
                UpdateSuggestions()
            end
        end)
    end
end

