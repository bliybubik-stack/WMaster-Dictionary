local function MakeButton(button)
    button.BackgroundColor3 = COLORS.glass2
    button.BackgroundTransparency = 0.05
    button.TextColor3 = COLORS.text

    Corner(button, 8)

    local stroke = Stroke(
        button,
        COLORS.border,
        1,
        0.25
    )

    button.MouseEnter:Connect(function()
        Tween(
            button,
            {
                BackgroundColor3 = COLORS.glass3
            },
            0.12
        )

        Tween(
            stroke,
            {
                Color = COLORS.borderLight,
                Transparency = 0
            },
            0.12
        )
    end)

    button.MouseLeave:Connect(function()
        Tween(
            button,
            {
                BackgroundColor3 = COLORS.glass2
            },
            0.12
        )

        Tween(
            stroke,
            {
                Color = COLORS.border,
                Transparency = 0.25
            },
            0.12
