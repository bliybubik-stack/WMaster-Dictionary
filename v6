local function GetCurrentWord()

    local inGameGui =
        parent:FindFirstChild("InGame")

    if not inGameGui then
        return ""
    end

    local frame =
        inGameGui:FindFirstChild("Frame")

    if not frame then
        return ""
    end

    local currentWordFrame =
        frame:FindFirstChild("CurrentWord")

    if currentWordFrame
        and currentWordFrame.Visible then

        local letters = {}
        local numbered = {}

        for _, child in
            ipairs(currentWordFrame:GetChildren()) do

            local idx =
                tonumber(child.Name)

            if idx
                and child:FindFirstChild("Letter") then

                table.insert(
                    numbered,
                    {
                        idx = idx,
                        obj = child
                    }
                )
            end
        end

        table.sort(
            numbered,
            function(a, b)
                return a.idx < b.idx
            end
        )

        for _, entry in
            ipairs(numbered) do

            local letter =
                entry.obj.Letter.Text

            if type(letter) == "string"
                and letter ~= "" then

                table.insert(
                    letters,
                    letter
                )
            end
        end

        if #letters > 0 then
            return table.concat(
                letters
            ):lower()
        end
    end

    local wordLabel =
        frame:FindFirstChild("WordLabel")
        or frame:FindFirstChild("CurrentWordLabel")
        or frame:FindFirstChild("WordDisplay")

    if wordLabel
        and wordLabel:IsA("TextLabel")
        and wordLabel.Text ~= "" then

        return wordLabel.Text:lower()
    end

    local answerBox =
        frame:FindFirstChild("TextBox")
        or frame:FindFirstChild("AnswerBox")
        or frame:FindFirstChild("ChatInput")

    if answerBox
        and answerBox:IsA("TextBox")
        and answerBox.Text ~= "" then

        return answerBox.Text:lower()
    end

    return ""
end

local function GetRequiredLetter()

    local inGameGui =
        parent:FindFirstChild("InGame")

    if not inGameGui then
        return nil
    end

    local frame =
        inGameGui:FindFirstChild("Frame")

    if not frame then
        return nil
    end

    local requirementLabel =
        frame:FindFirstChild("Requirement")
        or frame:FindFirstChild("RequiredLetter")
        or frame:FindFirstChild("NextLetter")

    if requirementLabel
        and requirementLabel:IsA("TextLabel") then

        local text =
            requirementLabel.Text

        local match =
            string.match(
                text,
                "([A-Za-z])"
            )

        if match then
            return match:lower()
        end
    end

    local wordLabel =
        frame:FindFirstChild("LastWord")
        or frame:FindFirstChild("PreviousWord")

    if wordLabel
        and wordLabel:IsA("TextLabel") then

        local word =
            wordLabel.Text

        if #word > 0 then

            local lastChar =
                string.sub(
                    word,
                    -1
                ):lower()

            if string.match(
                lastChar,
                "%a"
            ) then

                return lastChar
            end
        end
    end

    return nil
end

--========================================================
-- FAST PREFIX RANGE
--========================================================

local function FindWordRange(prefix)

    local low = 1
    local high = #filteredDictionary

    local startIdx
    local endIdx

    while low <= high do

        local mid =
            math.floor(
                (low + high) / 2
            )

        if filteredDictionary[mid]
            :sub(1, #prefix)
            < prefix then

            low = mid + 1

        else
            high = mid - 1
        end
    end

    startIdx = low

    low = startIdx
    high = #filteredDictionary

    while low <= high do

        local mid =
            math.floor(
                (low + high) / 2
            )

        if filteredDictionary[mid]
            :sub(1, #prefix)
            == prefix then

            low = mid + 1

        else
            high = mid - 1
        end
    end

    endIdx = high

    if startIdx > endIdx then
        return nil, nil
    end

    return startIdx, endIdx
end

--========================================================
-- SHUFFLING
--========================================================

local function ShuffleArray(array)

    local result = {}

    for i, value in
        ipairs(array) do

        result[i] = value
    end

    -- Fisher-Yates
    for i = #result, 2, -1 do

        local j =
            math.random(
                1,
                i
            )

        result[i],
        result[j] =
            result[j],
            result[i]
    end

    return result
end

local function BuildPrefixPool(prefix)

    prefix = prefix:lower()

    if prefix == "" then
        return {}
    end

    local range =
        prefixCache[prefix]

    local startIndex
    local endIndex

    if range then

        startIndex =
            range[1]

        endIndex =
            range[2]

    else

        startIndex,
        endIndex =
            FindWordRange(prefix)

        if startIndex then

            prefixCache[prefix] = {
                startIndex,
                endIndex
            }
        end
    end

    if not startIndex then
        return {}
    end

    local candidates = {}

    for i = startIndex,
        endIndex do

        local word =
            filteredDictionary[i]

        if word
            and word ~= prefix
            and not usedWords[word]
            and word:match(
                "^[a-z]+$"
            ) then

            table.insert(
                candidates,
                word
            )
        end
    end

    -- FULL RANDOM SHUFFLE
    candidates =
        ShuffleArray(candidates)

    return candidates
end

local function GetSuggestions(prefix)

    prefix =
        prefix:lower()

    if #prefix == 0 then
        return {}
    end

    -- PREFIX CHANGED
    if prefix ~= activeSuggestionPrefix then

        activeSuggestionPrefix =
            prefix

        activeSuggestionPool =
            BuildPrefixPool(prefix)
    end

    local suggestions = {}

    for i = 1,
        math.min(
            SUGGESTION_COUNT,
            #activeSuggestionPool
        ) do

        local word =
            activeSuggestionPool[i]

        if word
            and not usedWords[word] then

            table.insert(
                suggestions,
                word
            )
        end
    end

    return suggestions
end

--========================================================
-- TYPE WORD
--========================================================

local function TypeWord(word)

    if not word
        or word == "" then
        return
    end

    word =
        word:lower()

    -- Don't allow duplicate usage
    if usedWords[word] then
        return
    end

    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end

    usedWords[word] = true

    -- Remove immediately from active pool
    for i = #activeSuggestionPool, 1, -1 do

        if activeSuggestionPool[i] == word then

            table.remove(
                activeSuggestionPool,
                i
            )
        end
    end

    UpdateFilteredDictionary()

    task.defer(function()
        if UpdateSuggestions then
            UpdateSuggestions()
        end
    end)
end

