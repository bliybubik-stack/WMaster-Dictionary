    UpdateSuggestions = function()

        if not isInitialized or #filteredDictionary == 0 then
            statusLabel.Text = "loading..."
            return
        end

        local requiredLetter = GetRequiredLetter()
        local currentWord = GetCurrentWord()

        local searchPrefix = ""

        if currentWord and #currentWord > 0 then
            searchPrefix = currentWord

        elseif requiredLetter and #requiredLetter > 0 then
            searchPrefix = requiredLetter

        else
            for _,btn in ipairs(suggestionButtons) do
                btn.Visible = false
            end

            statusLabel.Text = "ready"
            prefixValue.Text = "..."

            wordCountLabel.Text =
                tostring(#filteredDictionary) .. " words"

            return
        end

        prefixValue.Text = '"' .. searchPrefix .. '"'

        local suggestions = GetSuggestions(searchPrefix)

        for i,btn in ipairs(suggestionButtons) do

            if suggestions[i] then

                local word = suggestions[i]
                local isUsed = usedWords[word:lower()] or false

                local formatted

                if isUsed and settings.showUsedWords then
                    formatted =
                        '<font color="#999999">'
                        .. word ..
                        '</font>'
                else
                    formatted =
                        '<font color="#FFFFFF">'
                        .. word ..
                        '</font>'
                end

                btn.Text = formatted
                btn.Visible = true

            else
                btn.Visible = false
            end
        end

        local visibleCount = 0

        for _,btn in ipairs(suggestionButtons) do
            if btn.Visible then
                visibleCount += 1
            end
        end

        suggestionsFrame.CanvasSize =
            UDim2.new(0,0,0,visibleCount * 26)

        if #suggestions > 0 then
            statusLabel.Text =
                tostring(#suggestions) .. " suggestions"
        else
            statusLabel.Text =
                "no matches"
        end

        wordCountLabel.Text =
            tostring(#filteredDictionary) .. " words"
    end

