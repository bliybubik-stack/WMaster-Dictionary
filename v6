local function MakeToggle(parentObject, initial, callback)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(0, 58, 0, 24)
    button.BackgroundColor3 =
        initial and COLORS.white or COLORS.glass3

    button.Text =
        initial and "ON" or "OFF"

    button.TextColor3 =
        initial and COLORS.black or COLORS.textDim

    button.Font = Enum.Font.GothamBold
    button.TextSize = 9
    button.AutoButtonColor = false

    MakeButton(button)

    local state = initial

    local function render()
        button.Text = state and "ON" or "OFF"

        Tween(
            button,
            {
                BackgroundColor3 =
                    state
                    and COLORS.white
                    or COLORS.glass3,

                TextColor3 =
                    state
                    and COLORS.black
                    or COLORS.textDim
            },
            0.12
        )
    end

    button.MouseButton1Click:Connect(function()
        state = not state
        render()

        if callback then
            callback(state)
        end
    end)

    return button
end

