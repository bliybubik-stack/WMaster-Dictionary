    local function showToast(message, subtext)
        table.insert(toastQueue, {
            message = message,
            subtext = subtext
        })

        if toastBusy then
            return
        end

        toastBusy = true

        while #toastQueue > 0 and not destroyed do
            local data = table.remove(toastQueue, 1)

            local toast = makeGlass(
                toastHolder,
                UDim2.new(0, 245, 0, 54),
                UDim2.new(0, 0, 0, 0)
            )

            toast.BackgroundTransparency = 1

            local title = makeLabel(
                toast,
                data.message,
                UDim2.new(1, -20, 0, 20),
                UDim2.new(0, 10, 0, 7)
            )

            title.TextTransparency = 1
            title.Font = Enum.Font.GothamBold

            local desc = makeLabel(
                toast,
                data.subtext or "",
                UDim2.new(1, -20, 0, 17),
                UDim2.new(0, 10, 0, 28)
            )

            desc.TextColor3 = UI.Gray
            desc.TextSize = 9
            desc.TextTransparency = 1

            tween(toast, {
                BackgroundTransparency = 0.12
            }, 0.18)

            tween(title, {
                TextTransparency = 0
            }, 0.18)

            tween(desc, {
                TextTransparency = 0
            }, 0.18)

            task.wait(1.8)

            tween(toast, {
                BackgroundTransparency = 1
            }, 0.2)

            tween(title, {
                TextTransparency = 1
            }, 0.2)

            tween(desc, {
                TextTransparency = 1
            }, 0.2)

            task.wait(0.22)

            toast:Destroy()
        end

        toastBusy = false
    end

