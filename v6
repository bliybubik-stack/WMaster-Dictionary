    return inGameGui:FindFirstChild("Frame")
end

local function GetAnswerBox()
    local frame = GetGameFrame()

    if not frame then
        return nil
    end

    local box =
        frame:FindFirstChild("TextBox")
        or frame:FindFirstChild("AnswerBox")
        or frame:FindFirstChild("Input")
        or frame:FindFirstChild("ChatInput")

    if box and box:IsA("TextBox") then
        return box
    end

    return nil
end

local function TypeWordHuman(word)
    local frame = GetGameFrame()

    if not frame then
        return
    end

    local answerBox = GetAnswerBox()

    if not answerBox then
        for i = 1, #word do
            local char = string.sub(word, i, i):lower()
            local keyCode = Enum.KeyCode[char:upper()]

            if keyCode then
                VirtualInput:SendKeyEvent(keyCode, true, false)
                HumanDelay()
                VirtualInput:SendKeyEvent(keyCode, false, false)

                if i < #word then
                    HumanDelay()
                end
            end
        end

        task.wait(0.05)

        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)

        return
    end

    answerBox:CaptureFocus()
    task.wait(0.05)

    answerBox.Text = ""

    task.wait(0.05)

    for i = 1, #word do
        local char = string.sub(word, i, i)
        local typo = SimulateTypo(word)

        if typo and typo.position == i then
            answerBox.Text = answerBox.Text .. typo.wrongLetter

            HumanDelay()

            task.wait(GetTypingDelay() / 1000 * 0.4)

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                true,
                false
            )

            task.wait(0.04)

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                false,
                false
            )

            HumanDelay()

            answerBox.Text = answerBox.Text .. typo.correctLetter
        else
            answerBox.Text = answerBox.Text .. char
        end

        HumanDelay()
    end

    task.wait(GetTypingDelay() / 1000 * 0.6)

    VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)

    task.wait(0.03)

    VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)

    task.wait(0.03)

    answerBox:ReleaseFocus()
end

local function TypeWordFast(word)
    local frame = GetGameFrame()

    if not frame then
        return
    end

    local answerBox = GetAnswerBox()

    if answerBox then
        answerBox:CaptureFocus()

        task.wait(0.03)

        answerBox.Text = word

        task.wait(0.03)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )

        answerBox:ReleaseFocus()
    else
        for i = 1, #word do
            local char = string.sub(word, i, i):lower()
            local keyCode = Enum.KeyCode[char:upper()]

            if keyCode then
                VirtualInput:SendKeyEvent(keyCode, true, false)

                if settings.blatant then
                    task.wait(0.005)
                else
                    task.wait(0.008)
                end

                VirtualInput:SendKeyEvent(keyCode, false, false)
            end
        end

        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, true, false)

        task.wait(0.02)

        VirtualInput:SendKeyEvent(Enum.KeyCode.Return, false, false)
    end
end

local function TypeWord(word)
    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end

    usedWords[word:lower()] = true

    UpdateFilteredDictionary()
end

local function IsKillerWord(word)
    local lowerWord = word:lower()

    for _, ending in ipairs(hardEndings) do
        if #ending <= #lowerWord
            and string.sub(lowerWord, -#ending) == ending then
            return true
        end
    end

    return false
end

local function FilterWordsByMode()
    local filtered = {}

    local minLen = settings.minWordLength or 3
    local maxLen = settings.maxWordLength or 20

    for _, word in ipairs(dictionary) do
        local wordLen = #word

        if wordLen >= minLen and wordLen <= maxLen then
            if not usedWords[word] or settings.showUsedWords then

                if settings.wordFilter == "all" then
                    table.insert(filtered, word)

                elseif settings.wordFilter == "short"
                    and wordLen >= 3
                    and wordLen <= 5 then

                    table.insert(filtered, word)

                elseif settings.wordFilter == "middle"
                    and wordLen >= 6
                    and wordLen <= 9 then

                    table.insert(filtered, word)

                elseif settings.wordFilter == "long"
                    and wordLen >= 10
                    and wordLen <= 20 then

                    table.insert(filtered, word)

                elseif settings.wordFilter == "killer"
                    and IsKillerWord(word)
                    and wordLen >= 3 then

                    table.insert(filtered, word)
                end
            end
        end
    end

    if settings.priorityMode == "speed" then
        table.sort(filtered, function(a, b)
            return #a < #b
        end)

    elseif settings.priorityMode == "killer" then
        table.sort(filtered, function(a, b)
            local scoreA = IsKillerWord(a) and 1 or 0
            local scoreB = IsKillerWord(b) and 1 or 0

            return scoreA > scoreB
        end)
    end

    return filtered
end

local function UpdateFilteredDictionary()
    filteredDictionary = FilterWordsByMode()
    prefixCache = {}

    if isInitialized then
        if _G.WordGangUpdateSuggestions then
            _G.WordGangUpdateSuggestions()
        end
    end
end

local function GetCurrentWord()
    local frame = GetGameFrame()

    if not frame then
        return ""
    end

    local currentWordFrame = frame:FindFirstChild("CurrentWord")

    if currentWordFrame and currentWordFrame.Visible then
        local letters = {}
        local numbered = {}

        for _, child in ipairs(currentWordFrame:GetChildren()) do
            local idx = tonumber(child.Name)

            if idx and child:FindFirstChild("Letter") then
                table.insert(numbered, {
                    idx = idx,
                    obj = child
                })
            end
        end

        table.sort(numbered, function(a, b)
            return a.idx < b.idx
        end)

        for _, entry in ipairs(numbered) do
            local letter = entry.obj.Letter.Text

            if type(letter) == "string" and letter ~= "" then
                table.insert(letters, letter)
            end
        end

        if #letters > 0 then
            return table.concat(letters):lower()
        end
    end

    local wordLabel =
        frame:FindFirstChild("WordLabel")
        or frame:FindFirstChild("CurrentWordLabel")
        or frame:FindFirstChild("WordDisplay")

    if wordLabel
        and wordLabel:IsA("TextLabel")
        and wordLabel.Text ~= "" then

        return wordLabel.Text:lower()
    end

    local answerBox = GetAnswerBox()

    if answerBox and answerBox.Text ~= "" then
        return answerBox.Text:lower()
    end

    return ""
end

local function GetRequiredLetter()
    local frame = GetGameFrame()

    if not frame then
        return nil
    end

    local requirementLabel =
        frame:FindFirstChild("Requirement")
        or frame:FindFirstChild("RequiredLetter")
        or frame:FindFirstChild("NextLetter")

    if requirementLabel and requirementLabel:IsA("TextLabel") then
        local text = requirementLabel.Text
        local match = string.match(text, "([A-Za-z])")

        if match then
            return match:lower()
        end
    end

    local wordLabel =
        frame:FindFirstChild("LastWord")
        or frame:FindFirstChild("PreviousWord")

    if wordLabel and wordLabel:IsA("TextLabel") then
        local word = wordLabel.Text

        if #word > 0 then
            local lastChar = string.sub(word, -1):lower()

            if string.match(lastChar, "%a") then
                return lastChar
            end
        end
    end

    return nil
end

local function FindWordRange(prefix)
    local low = 1
    local high = #filteredDictionary

    local startIdx
    local endIdx

    while low <= high do
        local mid = math.floor((low + high) / 2)

        if filteredDictionary[mid]:sub(1, #prefix) < prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end

    startIdx = low

    low = startIdx
    high = #filteredDictionary

    while low <= high do
        local mid = math.floor((low + high) / 2)

        if filteredDictionary[mid]:sub(1, #prefix) == prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end

    endIdx = high

    if startIdx > endIdx then
        return nil, nil
    end

    return startIdx, endIdx
end

local function GetSuggestions(prefix)
    prefix = prefix:lower()

    if #prefix == 0 then
        return {}
    end

    local suggestions = {}

    local range = prefixCache[prefix]

    local sIdx
    local eIdx

    if range then
        sIdx = range[1]
        eIdx = range[2]
    else
        sIdx, eIdx = FindWordRange(prefix)

        if sIdx then
            prefixCache[prefix] = {
                sIdx,
                eIdx
            }

            local cacheCount = 0

            for _ in pairs(prefixCache) do
                cacheCount = cacheCount + 1

                if cacheCount > 50 then
                    prefixCache = {}
                    break
                end
            end
        end
    end

    if not sIdx then
        return {}
    end

    for i = sIdx, math.min(
        sIdx + SUGGESTION_COUNT * 3,
        eIdx
    ) do

        local word = filteredDictionary[i]

        if word
            and #suggestions < SUGGESTION_COUNT
            and word ~= prefix
            and word:match("^[a-z]+$")
            and #word >= 3 then

            if not usedWords[word] or settings.showUsedWords then
                table.insert(suggestions, word)
            end
        end
    end

    return suggestions
end

local function FormatSuggestionText(word, currentPrefix)
    local isUsed = usedWords[word:lower()] or false
    local prefix = currentPrefix and currentPrefix:lower() or ""
    local lowerWord = word:lower()

    if isUsed and not settings.showUsedWords then
        return ""
    end

    if prefix ~= ""
        and string.sub(lowerWord, 1, #prefix) == prefix then

        local typedPart = string.sub(word, 1, #prefix)
        local remainingPart = string.sub(word, #prefix + 1)

        if isUsed and settings.showUsedWords then
            return
                '<font color="#FFFFFF">'
                .. typedPart
                .. '</font>'
                .. '<font color="#777777">'
                .. remainingPart
                .. '</font>'
        end

        return
            '<font color="#FFFFFF">'
            .. typedPart
            .. '</font>'
            .. remainingPart
    end

    if isUsed and settings.showUsedWords then
        return
            '<font color="#777777">'
            .. word
            .. '</font>'
    end

    return word
end

