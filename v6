    end)

    --=====================================================
    -- GAME TRIGGERS
    --=====================================================

    local function SetupTriggers()

        local inGameGui = parent:FindFirstChild("InGame")

        if not inGameGui then

            parent.ChildAdded:Connect(function(child)

                if child.Name == "InGame" then
                    task.wait(0.1)
                    SetupTriggers()
                end
            end)

            return
        end

        timeCounterRunning = true

        local frame = inGameGui:FindFirstChild("Frame")

        if not frame then
            return
        end

        local wordFrame =
            frame:FindFirstChild("CurrentWord")

        if wordFrame then

            wordFrame.ChildAdded:Connect(function()
                task.wait(0.05)
                UpdateSuggestions()
            end)

            wordFrame.ChildRemoved:Connect(function()
                task.wait(0.05)
                UpdateSuggestions()
            end)
        end

        local box =
            frame:FindFirstChild("TextBox")
            or frame:FindFirstChild("AnswerBox")
            or frame:FindFirstChild("ChatInput")

        if box and box:IsA("TextBox") then

            box:GetPropertyChangedSignal("Text"):Connect(function()
                UpdateSuggestions()
            end)
        end

        task.spawn(function()

            while screenGui.Parent do

                task.wait(0.5)

                if isInitialized then
                    UpdateSuggestions()
                end
            end
        end)
    end

    SetupTriggers()
    UpdateSuggestions()
end

