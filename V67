local function TypeWord(word, censor)
    if unloaded or not word or word == "" then return end

    local box = GetGameTextBox()
    if not box then
        return
    end

    isTyping = true
    local startTime = tick()

    box:CaptureFocus()

    local textBox = UserInputService:GetFocusedTextBox()
    if textBox and textBox:IsA("TextBox") then
        textBox.Text = ""
    end

    task.wait(thinkDelayCurrent * (0.8 + math.random() * 0.4))

    local chars = {}
    for i = 1, #word do
        table.insert(chars, word:sub(i,i))
    end

    if sortMode == "Random" then
        shuffleTable(chars)
    end

    local typed = ""
    local mistakes = 0
    local maxMistakes = math.max(0, math.floor(#word * (errorRate / 100)))

    for i, ch in ipairs(chars) do
        if unloaded then break end
        local delay = CalculateDelayForKeys(lastKey, ch)
        task.wait(delay)

        local shouldMistake = false
        if errorRate > 0 and i > 1 and i < #chars and #typed > 0 and mistakes < maxMistakes then
            local chance = errorRate / 100
            if riskyMistakes then chance = chance * 2.5 end
            if math.random() < chance then
                shouldMistake = true
                mistakes = mistakes + 1
            end
        end

        if shouldMistake then
            local wrongChar = string.char(math.random(97, 122))
            while wrongChar == ch do wrongChar = string.char(math.random(97, 122)) end
            SimulateKey(wrongChar)
            task.wait(delay * 0.5)
            Backspace(1)
            task.wait(delay * 0.3)
        end

        if censor then
            SimulateKey("*")
        else
            SimulateKey(ch)
        end
        typed = typed .. ch
        lastKey = ch
    end

    local finalDelay = thinkDelayCurrent * (0.5 + math.random() * 0.3)
    task.wait(finalDelay)

    PressEnter()
    isTyping = false

    if #word > 0 and word ~= "" then
        UsedWords[word] = true
    end

    task.wait(0.1)
    if UpdateList then
        UpdateList(lastDetected, lastRequiredLetter)
    end
end

local function IsWordAllowed(word, pattern)
    if not word or word == "" then return false end

    local censoredWord = word:gsub("[^%a]", "")
    if #censoredWord < 3 then return false end

    if Blacklist[censoredWord] then return false end

    if #pattern > 0 then
        local patternCheck = true
        local pat = pattern:lower()
        for i = 1, #pat do
            local char = pat:sub(i,i)
            if char ~= "_" and char ~= "?" and char ~= "*" then
                if i > #censoredWord then
                    patternCheck = false
                    break
                end
                if censoredWord:sub(i,i) ~= char then
                    patternCheck = false
                    break
                end
            end
        end
        if not patternCheck then return false end
    end

    if suffixMode and suffixMode ~= "" then
        if not censoredWord:endswith(suffixMode) then return false end
    end

    if lengthMode and lengthMode > 0 then
        if #censoredWord ~= lengthMode then return false end
    end

    return true
end

local function GetWordSuggestion(pattern)
    local valid = {}
    local bucket = Words

    if pattern and pattern ~= "" then
        local c = pattern:sub(1,1)
        if Buckets and Buckets[c] then
            bucket = Buckets[c]
        end
    end

    for _, word in ipairs(bucket) do
        if IsWordAllowed(word, pattern) then
            table.insert(valid, word)
        end
    end

    if #valid == 0 then return nil end

    if sortMode == "Random" then
        local randKey = #valid
        return valid[math.random(1, randKey)]
    elseif sortMode == "Shortest" then
        local shortest = valid[1]
        for _, w in ipairs(valid) do
            if #w < #shortest then shortest = w end
        end
        return shortest
    elseif sortMode == "Longest" then
        local longest = valid[1]
        for _, w in ipairs(valid) do
            if #w > #longest then longest = w end
        end
        return longest
    elseif sortMode == "Killer" then
        local killer = valid[1]
        local maxScore = GetKillerScore(killer)
        for _, w in ipairs(valid) do
            local score = GetKillerScore(w)
            if score > maxScore then
                maxScore = score
                killer = w
            end
        end
        return killer
    else
        return valid[1]
    end
end

local function SmartType(word, pattern, force, censor)
    if unloaded then return end
    if not word or word == "" then
        word = GetWordSuggestion(pattern)
    end
    if not word then return end

    if force then
        TypeWord(word, censor or false)
        return
    end

    if autoPlay then
        TypeWord(word, censor or false)
    end
end

local function UpdateList(detected, pattern)
    if unloaded then return end

    local searchQuery = SearchBox.Text:lower():gsub("[%s%c]+", "")
    local effectivePattern = pattern or detected or ""

    if searchQuery ~= "" then
        effectivePattern = searchQuery
    end

    local valid = {}
    local bucket = Words

    if effectivePattern and effectivePattern ~= "" and effectivePattern ~= "---" then
        local c = effectivePattern:sub(1,1)
        if Buckets and Buckets[c] then
            bucket = Buckets[c]
        end
    end

    for _, word in ipairs(bucket) do
        if IsWordAllowed(word, effectivePattern) then
            table.insert(valid, word)
        end
    end

    if sortMode == "Random" then
        shuffleTable(valid)
    elseif sortMode == "Shortest" then
        table.sort(valid, function(a,b) return #a < #b end)
    elseif sortMode == "Longest" then
        table.sort(valid, function(a,b) return #a > #b end)
    elseif sortMode == "Killer" then
        table.sort(valid, function(a,b) 
            local sa = GetKillerScore(a)
            local sb = GetKillerScore(b)
            if sa == sb then return #a > #b end
            return sa > sb
        end)
    end

    for _, btn in ipairs(ButtonCache) do
        btn.Visible = false
        btn.Parent = nil
        btn:Destroy()
    end
    ButtonCache = {}

    local count = 0
    local limit = 20
    for _, word in ipairs(valid) do
        if count >= limit then break end
        if word ~= detected then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = THEME.ItemBG
            btn.Text = word
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 14
            btn.TextColor3 = THEME.Text
            btn.BorderSizePixel = 1
            btn.BorderColor3 = THEME.Accent
            btn.Parent = ScrollList
            btn.AutoButtonColor = true

            btn.MouseButton1Click:Connect(function()
                if not unloaded then
                    SmartType(word, effectivePattern, true, false)
                end
            end)

            table.insert(ButtonCache, btn)
            count = count + 1
        end
    end

    local maxHeight = math.max(0, count * 32)
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, maxHeight)
end

local function CheckTurn()
    local isTurn, pattern = GetTurnInfo()
    if isTurn and pattern and pattern ~= "" then
        lastDetected = pattern
        lastRequiredLetter = pattern
        if UpdateList then
            UpdateList(pattern, pattern)
        end
        if autoPlay and not isTyping then
            SmartType(nil, pattern, false, false)
        end
    else
        if UpdateList then
            UpdateList("---", "")
        end
        if autoJoin then
            if tick() - lastAutoJoinCheck > AUTO_JOIN_RATE then
                lastAutoJoinCheck = tick()
            end
        end
    end
end

local lastRequiredLetter = ""

local function UpdateLoop()
    if unloaded then return end

    local detected, censored = GetCurrentGameWord()
    if detected ~= cachedDetected or censored ~= cachedCensored then
        cachedDetected = detected
        cachedCensored = censored
        if detected ~= "" and not censored then
            lastDetected = detected
        end
    end

    local isTurn, pattern = GetTurnInfo()
    if isTurn and pattern and pattern ~= "" then
        if pattern ~= lastRequiredLetter then
            lastRequiredLetter = pattern
            if UpdateList then
                UpdateList(pattern, pattern)
            end
        end
        if autoPlay and not isTyping and tick() - lastTypingStart > 1.5 then
            SmartType(nil, pattern, false, false)
        end
    else
        if UpdateList then
            UpdateList(lastDetected, lastRequiredLetter)
        end
    end

    if autoJoin then
        if tick() - lastAutoJoinCheck > AUTO_JOIN_RATE then
            lastAutoJoinCheck = tick()
            -- Auto join logic placeholder
        end
    end

    if not unloaded then
        task.wait(0.1)
        UpdateLoop()
    end
end

local function StartLogic()
    if runConn then runConn:Disconnect() end
    runConn = RunService.RenderStepped:Connect(UpdateLoop)
end

local function Cleanup()
    unloaded = true
    if runConn then runConn:Disconnect() runConn = nil end
    if inputConn then inputConn:Disconnect() inputConn = nil end
    if logConn then logConn:Disconnect() logConn = nil end
end

UpdateList = function(detected, pattern)
    if unloaded then return end
    if pattern and pattern ~= "" then
        lastRequiredLetter = pattern
    end
    if detected and detected ~= "" and detected ~= "---" then
        lastDetected = detected
    end

    local effectivePattern = pattern or lastDetected or ""
    if SearchBox.Text ~= "" then
        effectivePattern = SearchBox.Text:lower():gsub("[%s%c]+", "")
    end

    task.spawn(function()
        if listUpdatePending then return end
        listUpdatePending = true
        task.wait(0.05)
        listUpdatePending = false

        if unloaded then return end
        UpdateList(effectivePattern, effectivePattern)
    end)
end

StartLogic()

local toggleConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

inputConn = toggleConn

game:GetService("TeleportService").TeleportInit:Connect(function()
    Cleanup()
end)

game:BindToClose(function()
    Cleanup()
end)

return {
    Version = "V67",
    ToggleKey = TOGGLE_KEY,
    Toggle = function()
        MainFrame.Visible = not MainFrame.Visible
    end
}
