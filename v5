                -14
            )

        local function Refresh()
            local state =
                getter()

            button.Text =
                state and "ON" or "OFF"

            button.BackgroundColor3 =
                state
                and COLORS.hover
                or COLORS.panel2

            button.TextColor3 =
                state
                and COLORS.white
                or COLORS.gray
        end

        button.MouseButton1Click:Connect(
            function()

                setter(
                    not getter()
                )

                Refresh()

                UpdateFilteredDictionary()
            end
        )

        Refresh()

        return row
    end

    local function AddNumber(
        name,
        description,
        value,
        min,
        max,
        setter
    )

        local row =
            SettingRow(
                name,
                description
            )

        local input =
            Instance.new("TextBox")

        input.Size =
            UDim2.new(
                0,
                62,
                0,
                28
            )

        input.Position =
            UDim2.new(
                1,
                -74,
                0.5,
                -14
            )

        input.BackgroundColor3 =
            COLORS.panel2

        input.BorderSizePixel = 0

        input.Text =
            tostring(value)

        input.TextColor3 =
            COLORS.white

        input.TextSize = 10

        input.Font =
            Enum.Font.GothamBold

        input.ClearTextOnFocus = false

        input.Parent = row

        Corner(
            input,
            6
        )

        Stroke(
            input,
            COLORS.border,
            1,
            0
        )

        input.FocusLost:Connect(
            function()

                local number =
                    tonumber(
                        input.Text
                    )

                if number then
                    number =
                        math.clamp(
                            number,
                            min,
                            max
                        )

                    setter(number)

                    input.Text =
                        tostring(number)

                    UpdateFilteredDictionary()
                else
                    input.Text =
                        tostring(value)
                end
            end
        )

        return row
    end

    local function AddCycle(
        name,
        description,
        values,
        names,
        getter,
        setter
    )

        local row =
            SettingRow(
                name,
                description
            )

        local button =
            CreateButton(
                row,
                names[1]
            )

        button.Size =
            UDim2.new(
                0,
                105,
                0,
                28
            )

        button.Position =
            UDim2.new(
                1,
                -117,
                0.5,
                -14
            )

        local index = 1

        for i, value in ipairs(values) do
            if value == getter() then
                index = i
                break
            end
        end

        button.Text =
            names[index]

        button.MouseButton1Click:Connect(
            function()

                index =
                    index % #values + 1

                setter(
                    values[index]
                )

                button.Text =
                    names[index]

                UpdateFilteredDictionary()
            end
        )

        return row
    end

