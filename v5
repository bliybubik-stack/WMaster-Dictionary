local function SafeCall(callback, ...)
    local args = table.pack(...)

    local success, result = pcall(function()
        return callback(table.unpack(args, 1, args.n))
    end)

    if success then
        return true, result
    end

    return false, nil
end

local function ClampNumber(value, minimum, maximum, fallback)
    value = tonumber(value)

    if not value then
        return fallback
    end

    return math.clamp(value, minimum, maximum)
end

local function CleanWord(word)
    if type(word) ~= "string" then
        return nil
    end

    word = word:lower()
    word = word:gsub("[\r\n]", "")
    word = word:gsub("^%s+", "")
    word = word:gsub("%s+$", "")

    if not word:match("^[a-z]+$") then
        return nil
    end

    if #word < CONFIG.MinDictionaryLength then
        return nil
    end

    if #word > CONFIG.MaxDictionaryLength then
        return nil
    end

    return word
end

local function IsValidWord(word)
    return CleanWord(word) ~= nil
end

