local function GetGamePrefix()
    local inGame = PlayerGui:FindFirstChild("InGame")

    if not inGame then
        return ""
    end

    local frame = inGame:FindFirstChild("Frame")

    if not frame then
        return ""
    end

    -- CurrentWord container
    local currentWord = frame:FindFirstChild("CurrentWord")

    if currentWord then
        local numbered = {}

        for _, child in ipairs(currentWord:GetChildren()) do
            local index = tonumber(child.Name)

            if index and child:FindFirstChild("Letter") then
                table.insert(numbered, {
                    index = index,
                    object = child
                })
            end
        end

        table.sort(numbered, function(a, b)
            return a.index < b.index
        end)

        local letters = {}

        for _, entry in ipairs(numbered) do
            local letter = entry.object.Letter

            if letter:IsA("TextLabel")
                or letter:IsA("TextButton")
            then
                local value = letter.Text or ""

                if value ~= "" then
                    table.insert(letters, value)
                end
            end
        end

        if #letters > 0 then
            return table.concat(letters):lower()
        end
    end

    local labels = {
        "WordLabel",
        "CurrentWordLabel",
        "WordDisplay",
        "Requirement",
        "RequiredLetter",
        "NextLetter"
    }

    for _, name in ipairs(labels) do
        local object = frame:FindFirstChild(name)

        if object and object:IsA("TextLabel") then
            local text = object.Text or ""

            local letter = text:match("([A-Za-z]+)")

            if letter and letter ~= "" then
                return letter:lower()
            end
        end
    end

    return ""
end

