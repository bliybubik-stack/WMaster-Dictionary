--//==============================================================
--// FILTER INDEX
--//==============================================================

local function PassLength(word)
    local length = #word

    return length >= settings.minWordLength
       and length <= settings.maxWordLength
end

local function PassFilter(word)
    if not PassLength(word) then
        return false
    end

    local filter = settings.wordFilter

    if filter == "all" then
        return true
    end

    if filter == "short" then
        return #word >= 3 and #word <= 5
    end

    if filter == "middle" then
        return #word >= 6 and #word <= 9
    end

    if filter == "long" then
        return #word >= 10 and #word <= 20
    end

    if filter == "killer" then
        return IsKillerWord(word)
    end

    return true
end

local function RebuildFilteredDictionary()
    filteredDictionary = {}

    for _, word in ipairs(dictionary) do
        if PassFilter(word) then
            if not blacklistedWords[word] then
                if settings.showUsedWords or not usedWords[word] then
                    filteredDictionary[#filteredDictionary + 1] = word
                end
            end
        end
    end

    -- NEVER priority-sort this table.
    -- Prefix binary search requires alphabetical order.
    table.sort(filteredDictionary)

    prefixCache = {}
end

--//==============================================================
--// PREFIX SEARCH
--//==============================================================

local function FindWordRange(prefix)
    prefix = prefix:lower()

    local low = 1
    local high = #filteredDictionary

    local startIndex

    while low <= high do
        local mid = math.floor((low + high) / 2)

        local word = filteredDictionary[mid]

        if word:sub(1, #prefix) < prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end

    startIndex = low

    if startIndex > #filteredDictionary then
        return nil, nil
    end

    if filteredDictionary[startIndex]:sub(1, #prefix) ~= prefix then
        return nil, nil
    end

    low = startIndex
    high = #filteredDictionary

    while low <= high do
        local mid = math.floor((low + high) / 2)

        local word = filteredDictionary[mid]

        if word:sub(1, #prefix) == prefix then
            low = mid + 1
        else
            high = mid - 1
        end
    end

    return startIndex, high
end

--//==============================================================
--// WORD SCORING
--//==============================================================

local function IsRecent(word)
    for _, recent in ipairs(recentWords) do
        if recent == word then
            return true
        end
    end

    return false
end

local function AddRecent(word)
    table.insert(recentWords, 1, word)

    while #recentWords > 30 do
        table.remove(recentWords)
    end
end

local function ScoreWord(word, prefix)
    local score = 0

    if favoriteWords[word] then
        score += 10000
    end

    if settings.priorityMode == "killer" then
        score += KillerScore(word) * 10
    elseif settings.priorityMode == "speed" then
        score += math.max(0, 30 - #word) * 10
    else
        score += 20

        if IsKillerWord(word) then
            score += 35
        end

        if #word >= 4 and #word <= 9 then
            score += 20
        end
    end

    if settings.smartRandom then
        score += math.random(0, 12)
    end

    if settings.avoidRepeatedStarts and IsRecent(word) then
        score -= 1000
    end

    -- Slightly favor words that are not absurdly long.
    score -= math.max(0, #word - 14) * 2

    return score
end

--//==============================================================
--// SUGGESTIONS
--//==============================================================

local function GetSuggestions(prefix)
    prefix = tostring(prefix or ""):lower()

    if #prefix == 0 then
        return {}
    end

    suggestionRequests += 1

    local range = prefixCache[prefix]

    local startIndex
    local endIndex

    if range then
        startIndex = range[1]
        endIndex = range[2]
    else
        startIndex, endIndex = FindWordRange(prefix)

        if startIndex then
            prefixCache[prefix] = {
                startIndex,
                endIndex
            }
        end
    end

    if not startIndex then
        return {}
    end

    local candidates = {}

    -- Preserve the original logic:
    -- scan forward from the prefix range.
    --
    -- We scan more candidates internally so priority modes
    -- can reorder the visible results without touching the
    -- alphabetical index.
    local scanLimit = math.min(
        endIndex,
        startIndex + CONFIG.SuggestionCount * 8
    )

    for index = startIndex, scanLimit do
        local word = filteredDictionary[index]

        if word
            and word ~= prefix
            and word:match("^[a-z]+$")
            and #word >= 3
        then
            if not blacklistedWords[word] then
                if settings.showUsedWords or not usedWords[word] then
                    candidates[#candidates + 1] = word
                end
            end
        end
    end

    if settings.priorityMode ~= "balanced" or settings.smartRandom then
        table.sort(candidates, function(a, b)
            return ScoreWord(a, prefix) > ScoreWord(b, prefix)
        end)
    end

    local suggestions = {}

    for i = 1, math.min(CONFIG.SuggestionCount, #candidates) do
        suggestions[#suggestions + 1] = candidates[i]
    end

    return suggestions
end

