--//========================================================
--// SUGGESTION BUTTON FORMAT
--//========================================================

local function FormatSuggestionText(
    word,
    currentPrefix
)
    local isUsed =
        usedWords[
            word:lower()
        ] == true

    local prefix =
        currentPrefix
        and currentPrefix:lower()
        or ""

    local lowerWord =
        word:lower()

    if isUsed
        and not settings.showUsedWords then

        return ""
    end

    local typedPart =
        string.sub(
            word,
            1,
            #prefix
        )

    local remainingPart =
        string.sub(
            word,
            #prefix + 1
        )

    if prefix ~= ""
        and string.sub(
            lowerWord,
            1,
            #prefix
        ) == prefix then

        if isUsed
            and settings.showUsedWords then

            return '<font color="#777777">'
                .. typedPart
                .. '</font>'
                .. '<font color="#AAAAAA">'
                .. remainingPart
                .. '</font>'
        end

        return '<font color="#FFFFFF">'
            .. typedPart
            .. '</font>'
            .. remainingPart
    end

    if isUsed
        and settings.showUsedWords then

        return '<font color="#777777">'
            .. word
            .. '</font>'
    end

    return word
end

