    local currentWordFrame = frame:FindFirstChild("CurrentWord")

    if currentWordFrame and currentWordFrame.Visible ~= false then
        local numbered = {}

        for _, child in ipairs(currentWordFrame:GetChildren()) do
            local index = tonumber(child.Name)

            if index then
                local letterObject = child:FindFirstChild("Letter")

                if letterObject
                    and letterObject:IsA("TextLabel")
                then
                    numbered[#numbered + 1] = {
                        index = index,
                        object = letterObject
                    }
                end
            end
        end

        table.sort(numbered, function(a, b)
            return a.index < b.index
        end)

        local letters = {}

        for _, entry in ipairs(numbered) do
            local text = entry.object.Text

            if type(text) == "string" and text ~= "" then
                letters[#letters + 1] = text
            end
        end

        if #letters > 0 then
            return table.concat(letters):lower()
        end
    end

    local labels = {
        "WordLabel",
        "CurrentWordLabel",
        "WordDisplay",
        "CurrentWord"
    }

    for _, name in ipairs(labels) do
        local object = frame:FindFirstChild(name)

        if object
            and object:IsA("TextLabel")
            and object.Text ~= ""
        then
            return object.Text:lower()
        end
    end

    local box = FindInputBox()

    if box and box.Text ~= "" then
        return box.Text:lower()
    end

    return ""
end

local function GetRequiredLetter()
    local frame = FindGameFrame()

    if not frame then
        return nil
    end

    local names = {
        "Requirement",
        "RequiredLetter",
        "NextLetter"
    }

    for _, name in ipairs(names) do
        local label = frame:FindFirstChild(name)

        if label and label:IsA("TextLabel") then
            local letter = label.Text:match("([A-Za-z])")

            if letter then
                return letter:lower()
            end
        end
    end

    local previousNames = {
        "LastWord",
        "PreviousWord"
    }

    for _, name in ipairs(previousNames) do
        local label = frame:FindFirstChild(name)

        if label
            and label:IsA("TextLabel")
            and #label.Text > 0
        then
            local lastCharacter = label.Text:sub(-1):lower()

            if lastCharacter:match("%a") then
                return lastCharacter
            end
        end
    end

    return nil
end

