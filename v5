end)

--==============================================================
// KEYBOARD SHORTCUTS
//==============================================================

UserInputService.InputBegan:Connect(
    function(input, processed)
        if processed then
            return
        end

        if isDestroyed then
            return
        end

        if input.KeyCode ==
            Enum.KeyCode.RightShift
        then
            if GUI.Main then
                GUI.Main.Visible =
                    not GUI.Main.Visible
            end
        end

        if input.KeyCode ==
            Enum.KeyCode.RightControl
        then
            if GUI.Settings then
                GUI.Settings.Visible =
                    not GUI.Settings.Visible
            end
        end

        if input.KeyCode ==
            Enum.KeyCode.F8
        then
            settings.autoPlay =
                not settings.autoPlay

            if settings.autoPlay then
                AutoPlayLoop()
            else
                StopAutoPlay()
            end

            if GUI.AutoButton then
                GUI.AutoButton.Text =
                    settings.autoPlay
                    and "AUTO • ON"
                    or "AUTO"
            end
        end

        if input.KeyCode ==
            Enum.KeyCode.F7
        then
            usedWords = {}

            RebuildFilteredDictionary()

            QueueSuggestionUpdate(0)
        end
    end
)

--==============================================================
// DICTIONARY STATUS
//==============================================================

local function UpdateLoadingUI(text, progress)
    if not GUI.Main then
        return
    end

    if GUI.Status then
        GUI.Status.Text = "● " .. text
    end

    if GUI.WordCount then
        GUI.WordCount.Text =
            tostring(
                math.floor(
                    progress * 100
                )
            ) ..
            "%"
    end
end

--==============================================================
// LOAD DICTIONARIES
//==============================================================

local function LoadAllDictionaries()
    dictionary = {}
    dictionarySet = {}

    local totalSources =
        #DICTIONARY_SOURCES

    for index, source in ipairs(
        DICTIONARY_SOURCES
    ) do
        UpdateLoadingUI(
            "LOADING " ..
            source.name:upper(),
            (index - 1) /
                totalSources
        )

        local before =
            #dictionary

        LoadDictionarySource(source)

        local added =
            #dictionary - before

        source.count = added

        UpdateLoadingUI(
            source.name:upper() ..
            " +" ..
            tostring(added),
            index / totalSources
        )

        task.wait()
    end

    if #dictionary == 0 then
        BuildFallback()
    end

    table.sort(dictionary)

    RebuildFilteredDictionary()

    isInitialized = true

    if GUI.Status then
        GUI.Status.Text =
            "● " ..
            tostring(#dictionary) ..
            " WORDS LOADED"
    end

    if GUI.WordCount then
        GUI.WordCount.Text =
            tostring(
                #filteredDictionary
            ) ..
            " available"
    end
end

