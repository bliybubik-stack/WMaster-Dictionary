local function PressKey(key)
    if not key then
        return
    end

    VirtualInputManager:SendKeyEvent(
        key,
        true,
        false,
        game
    )

    task.wait(0.01)

    VirtualInputManager:SendKeyEvent(
        key,
        false,
        false,
        game
    )
end

local function PressEnter()
    VirtualInputManager:SendKeyEvent(
        Enum.KeyCode.Return,
        true,
        false,
        game
    )

    task.wait(0.025)

    VirtualInputManager:SendKeyEvent(
        Enum.KeyCode.Return,
        false,
        false,
        game
    )
end

local function TypeWordHuman(word)
    if isTyping then
        return
    end

    isTyping = true

    local answerBox = GetInputBox()

    if answerBox then
        answerBox:CaptureFocus()

        task.wait(0.04)

        answerBox.Text = ""

        local typo = SimulateTypo(word)

        for i = 1, #word do
            local character =
                string.sub(word, i, i)

            if typo and typo.position == i then
                answerBox.Text =
                    answerBox.Text ..
                    typo.wrongLetter

                HumanDelay()

                task.wait(
                    GetTypingDelay() / 1000 * 0.35
                )

                PressKey(
                    Enum.KeyCode.Backspace
                )

                HumanDelay(0.7)

                answerBox.Text =
                    answerBox.Text ..
                    typo.correctLetter
            else
                answerBox.Text =
                    answerBox.Text ..
                    character
            end

            HumanDelay()
        end

        task.wait(
            GetTypingDelay() / 1000 * 0.5
        )

        PressEnter()

        task.wait(0.04)

        answerBox:ReleaseFocus()
    else
        for i = 1, #word do
            local character =
                string.sub(word, i, i)

            local key =
                GetKeyCode(character)

            if key then
                PressKey(key)
            end

            HumanDelay()
        end

        task.wait(0.05)

        PressEnter()
    end

    isTyping = false
end

local function TypeWordFast(word)
    if isTyping then
        return
    end

    isTyping = true

    local answerBox = GetInputBox()

    if answerBox then
        answerBox:CaptureFocus()

        task.wait(0.025)

        answerBox.Text = word

        task.wait(0.025)

        PressEnter()

        task.wait(0.025)

        answerBox:ReleaseFocus()
    else
        for i = 1, #word do
            local key =
                GetKeyCode(
                    string.sub(word, i, i)
                )

            if key then
                PressKey(key)

                if settings.blatant then
                    task.wait(0.004)
                else
                    task.wait(0.008)
                end
            end
        end

        PressEnter()
    end

    isTyping = false
end

