    local children = historyList:GetChildren()

    local labels = {}

    for _, child in ipairs(children) do
        if child:IsA("TextLabel") then
            labels[#labels + 1] = child
        end
    end

    while #labels > 12 do
        local oldest = table.remove(labels, 1)

        if oldest then
            oldest:Destroy()
        end
    end
end

--//==============================================================
--// TYPE WORD
--//==============================================================

local function MarkUsed(word)
    word = word:lower()

    usedWords[word] = true

    totalTyped += 1

    AddRecent(word)
    AddHistory(word)

    if GUI.WordCount then
        GUI.WordCount.Text =
            tostring(#filteredDictionary) ..
            " words • used " ..
            tostring(totalTyped)
    end
end

local function TypeWord(word)
    if not word or word == "" then
        return
    end

    word = word:lower()

    if not IsValidWord(word) then
        return
    end

    if blacklistedWords[word] then
        return
    end

    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end

    MarkUsed(word)

    successfulSuggestions += 1

    RebuildFilteredDictionary()

    QueueSuggestionUpdate(0.05)
end

--//==============================================================
--// AUTO PLAY
--//==============================================================

local function ChooseAutoWord(suggestions)
    if #suggestions == 0 then
        return nil
    end

    if settings.priorityMode == "killer" then
        return suggestions[1]
    end

    if settings.priorityMode == "speed" then
        local shortest = suggestions[1]

        for _, word in ipairs(suggestions) do
            if #word < #shortest then
                shortest = word
            end
        end

        return shortest
    end

    if settings.smartRandom then
        return suggestions[
            math.random(
                1,
                #suggestions
            )
        ]
    end

    return suggestions[1]
end

local function AutoPlayLoop()
    if isAutoPlaying then
        return
    end

    isAutoPlaying = true

    task.spawn(function()
        while isAutoPlaying and not isDestroyed do
            task.wait(
                math.max(
                    0.15,
                    tonumber(settings.autoPlayDelay) or 1.5
                )
            )

            if not isInitialized then
                continue
            end

            local current = GetCurrentWord()
            local required = GetRequiredLetter()

            local prefix = ""

            if current and #current > 0 then
                prefix = current
            elseif required and #required > 0 then
                prefix = required
            end

            if prefix ~= "" then
                local suggestions = GetSuggestions(prefix)

                local word = ChooseAutoWord(suggestions)

                if word then
                    TypeWord(word)
                end
            end
        end

        isAutoPlaying = false
    end)
end

local function StopAutoPlay()
    isAutoPlaying = false
end

