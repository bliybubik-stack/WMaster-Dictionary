local function LoadDictionaryFromTXT(url)
    local success, content =
        pcall(function()
            return game:HttpGet(url)
        end)

    if not success then
        return nil, 0
    end

    local words = {}
    local count = 0

    for line in content:gmatch(
        "[^\r\n]+"
    ) do

        local word =
            line:gsub(
                "%s+",
                ""
            ):lower()

        if word:match(
            "^[a-z]+$"
        )
        and #word >= 3
        and #word <= 20 then

            if not words[word] then
                words[word] = true
                count += 1
            end
        end
    end

    return words, count
end

local function LoadDictionaryFromJSON(url)
    local success, content =
        pcall(function()
            return game:HttpGet(url)
        end)

    if not success then
        return nil, 0
    end

    local data

    local ok =
        pcall(function()
            data =
                HttpService:JSONDecode(
                    content
                )
        end)

    if not ok
        or type(data) ~= "table" then

        return nil, 0
    end

    local words = {}
    local count = 0

    for word in pairs(data) do
        if word:match(
            "^[a-zA-Z]+$"
        )
        and #word >= 3
        and #word <= 20 then

            local clean =
                word:lower()

            if not words[clean] then
                words[clean] = true
                count += 1
            end
        end
    end

    return words, count
end

local function LoadAllDictionaries()
    local wordMap = {}
    local totalWords = 0

    for _, source in ipairs(
        DICTIONARY_SOURCES
    ) do

        local words
        local count = 0

        if source.type == "txt" then
            words, count =
                LoadDictionaryFromTXT(
                    source.url
                )

        elseif source.type == "json" then
            words, count =
                LoadDictionaryFromJSON(
                    source.url
                )
        end

        if words and count > 0 then
            local newWords = 0

            for word in pairs(words) do
                if not wordMap[word] then
                    wordMap[word] = true
                    newWords += 1
                end
            end

            totalWords += newWords

            source.loaded = true
        end
    end

    if totalWords == 0 then
        local fallback = {
            "apple",
            "ant",
