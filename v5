local function GetGameFrame()
    local inGame =
        PlayerGui:FindFirstChild("InGame")

    if not inGame then
        return nil
    end

    return inGame:FindFirstChild("Frame")
end

local function GetCurrentWord()
    local frame =
        GetGameFrame()

    if not frame then
        return ""
    end

    local currentWordFrame =
        frame:FindFirstChild(
            "CurrentWord"
        )

    if currentWordFrame
        and currentWordFrame.Visible then

        local letters = {}
        local numbered = {}

        for _, child in ipairs(
            currentWordFrame:GetChildren()
        ) do

            local idx =
                tonumber(child.Name)

            local letter =
                child:FindFirstChild("Letter")

            if idx and letter then
                table.insert(
                    numbered,
                    {
                        idx = idx,
                        obj = child
                    }
                )
            end
        end

        table.sort(
            numbered,
            function(a, b)
                return a.idx < b.idx
            end
        )

        for _, entry in ipairs(numbered) do
            local letter =
                entry.obj.Letter.Text

            if type(letter) == "string"
                and letter ~= "" then

                table.insert(
                    letters,
                    letter
                )
            end
        end

        if #letters > 0 then
            return table.concat(
                letters
            ):lower()
        end
    end

    local labelNames = {
        "WordLabel",
        "CurrentWordLabel",
        "WordDisplay"
    }

    for _, name in ipairs(labelNames) do
        local label =
            frame:FindFirstChild(name)

        if label
            and label:IsA("TextLabel")
            and label.Text ~= "" then

            return label.Text:lower()
        end
    end

    local answerBox =
        GetInputBox()

    if answerBox
        and answerBox.Text ~= "" then

        return answerBox.Text:lower()
    end

    return ""
end

local function GetRequiredLetter()
    local frame =
        GetGameFrame()

    if not frame then
        return nil
    end

    local requirementNames = {
        "Requirement",
        "RequiredLetter",
        "NextLetter"
    }

    for _, name in ipairs(
        requirementNames
    ) do

        local label =
            frame:FindFirstChild(name)

        if label
            and label:IsA("TextLabel") then

            local match =
                string.match(
                    label.Text,
                    "([A-Za-z])"
                )

            if match then
                return match:lower()
            end
        end
    end

    local previousNames = {
        "LastWord",
        "PreviousWord"
    }

    for _, name in ipairs(
        previousNames
    ) do

        local label =
            frame:FindFirstChild(name)

        if label
            and label:IsA("TextLabel") then

            local word =
                label.Text

            if #word > 0 then
                local last =
                    string.sub(
                        word,
                        -1
                    ):lower()

                if last:match("%a") then
                    return last
                end
            end
        end
    end

    return nil
end

local function GetSearchPrefix()
    local current =
        GetCurrentWord()

    if current and #current > 0 then
        return current
    end

    local required =
        GetRequiredLetter()

    if required
        and #required > 0 then

        return required
    end

    return ""
end

--//========================================================
--// HISTORY
--//========================================================

local function AddHistory(word)
    table.insert(
        wordHistory,
        1,
        {
            word = word,
            time = os.time()
        }
    )

    while #wordHistory > 50 do
        table.remove(
            wordHistory
        )
    end
end

local function IsFavorite(word)
    return favoriteWords[
        word:lower()
    ] == true
end

local function ToggleFavorite(word)
    word =
        word:lower()

    favoriteWords[word] =
        not favoriteWords[word]

    return favoriteWords[word]
end

--//========================================================
--// TYPE WORD
--//========================================================

local function RegisterTypedWord(word)
    word =
        word:lower()

    usedWords[word] = true

    totalTyped += 1

    AddHistory(word)

    UpdateFilteredDictionary()
end

local function TypeWord(word)
    if not word
        or word == ""
        or isTyping then

        return
    end

    word =
        word:lower()

    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end

    RegisterTypedWord(word)

    Notify(
        "typed  •  " .. word,
        1.25
    )
end

--//========================================================
--// SMART WORD SELECTION
--//========================================================

local function SelectSuggestion(words)
    if #words == 0 then
        return nil
    end

    if not settings.smartRandom then
        return words[1]
    end

    if settings.priorityMode == "killer" then
        local best
        local bestScore = -math.huge

        for _, word in ipairs(words) do
            local score =
                GetKillerScore(word)

            if settings.avoidRepeats
                and wordHistory[1]
                and word ==
                    wordHistory[1].word then

                score -= 100
            end

            score += math.random(0, 10)

            if score > bestScore then
                bestScore = score
                best = word
            end
        end

        return best
    end

    if settings.priorityMode == "speed" then
        return words[
            math.random(
                1,
                math.min(
                    5,
                    #words
                )
            )
        ]
    end

    return words[
        math.random(
            1,
            #words
        )
    ]
end

--//========================================================
--// AUTO PLAY
--//========================================================

local function AutoPlayLoop()
    if isAutoPlaying then
        return
    end

    isAutoPlaying = true

    Notify(
        "auto mode enabled",
        1.5
    )

    while settings.autoPlay
        and isInitialized
        and not guiDestroyed do

        if not isTyping then
            local prefix =
                GetSearchPrefix()

            if prefix ~= "" then
                local suggestions =
                    GetSuggestions(prefix)

                totalSuggestions +=
                    #suggestions

                if #suggestions > 0 then
                    local selected =
                        SelectSuggestion(
                            suggestions
                        )

                    if selected then
                        TypeWord(selected)
                    end
                end
            end
        end

        task.wait(
            math.max(
                0.2,
                settings.autoPlayDelay
            )
        )
    end

    isAutoPlaying = false
end

