local function AddWord(word)
    word = CleanWord(word)

    if not word then
        return false
    end

    if not dictionarySet[word] then
        dictionarySet[word] = true
        dictionary[#dictionary + 1] = word
        return true
    end

    return false
end

local function LoadTXTContent(content)
    if type(content) ~= "string" then
        return 0
    end

    local added = 0

    for line in content:gmatch("[^\r\n]+") do
        local word = line

        word = word:gsub("^%s+", "")
        word = word:gsub("%s+$", "")

        -- Handles files where words have comments after them.
        word = word:match("^([%a]+)") or word

        if AddWord(word) then
            added += 1
        end
    end

    return added
end

local function LoadJSONContent(content)
    if type(content) ~= "string" then
        return 0
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)

    if not success or type(data) ~= "table" then
        return 0
    end

    local added = 0

    for word in pairs(data) do
        if AddWord(word) then
            added += 1
        end
    end

    return added
end

local function HTTPGet(url)
    if type(url) ~= "string" or url == "" then
        return nil
    end

    local success, content = pcall(function()
        return game:HttpGet(url)
    end)

    if success and type(content) == "string" then
        return content
    end

    return nil
end

local function LoadUltimateLocalFile()
    if type(readfile) ~= "function" then
        return 0
    end

    if type(isfile) == "function" then
        local ok, exists = pcall(function()
            return isfile("ultimate_words_v4.txt")
        end)

        if not ok or not exists then
            return 0
        end
    end

    local success, content = pcall(function()
        return readfile("ultimate_words_v4.txt")
    end)

    if not success or not content then
        return 0
    end

    return LoadTXTContent(content)
end

local function LoadDictionarySource(source)
    source.status = "loading"

    local before = #dictionary

    local content

    if source.name == "Ultimate V4" then
        local localAdded = LoadUltimateLocalFile()

        if localAdded > 0 then
            source.loaded = true
            source.count = localAdded
            source.status = "local file"
            return localAdded
        end
    end

    content = HTTPGet(source.url)

    if not content then
        source.status = "failed"
        source.loaded = false
        source.count = 0
        return 0
    end

    local added = 0

    if source.type == "json" then
        added = LoadJSONContent(content)
    else
        added = LoadTXTContent(content)
    end

    source.count = added
    source.loaded = added > 0
    source.status = added > 0 and "loaded" or "empty"

    return #dictionary - before
end

