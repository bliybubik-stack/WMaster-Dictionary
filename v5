--========================================================--
-- UPDATE SUGGESTIONS
--========================================================--

function UpdateSuggestions()

    if not isInitialized
        or #filteredDictionary == 0 then

        if statusLabel then
            statusLabel.Text =
                "loading..."
        end

        return
    end

    local requiredLetter =
        GetRequiredLetter()

    local searchPrefix = ""

    local currentWord =
        GetCurrentWord()

    if currentWord
        and #currentWord > 0 then

        searchPrefix =
            currentWord

    elseif requiredLetter
        and #requiredLetter > 0 then

        searchPrefix =
            requiredLetter

    else

        for _, btn in ipairs(
            suggestionButtons
        ) do
            btn.Visible = false
        end

        currentPrefix = ""

        if prefixValue then
            prefixValue.Text =
                "..."
        end

        if statusLabel then
            statusLabel.Text =
                "waiting for round..."
        end

        if wordCountLabel then
            wordCountLabel.Text =
                #filteredDictionary
                .. " words"
        end

        return
    end

    currentPrefix =
        searchPrefix

    if prefixValue then
        prefixValue.Text =
            '"' ..
            searchPrefix ..
            '"'
    end

    local suggestions =
        GetSuggestions(
            searchPrefix
        )

    lastSuggestedWords =
        suggestions

    for i, btn in ipairs(
        suggestionButtons
    ) do

        if suggestions[i] then

            local formatted =
                FormatSuggestionText(
                    suggestions[i],
                    searchPrefix
                )

            if formatted ~= "" then

                btn.Text =
                    formatted

                btn.Visible = true

            else
                btn.Visible = false
            end

        else
            btn.Visible = false
        end
    end

    local visibleCount = 0

    for _, btn in ipairs(
        suggestionButtons
    ) do

        if btn.Visible then
            visibleCount += 1
        end
    end

    suggestionsFrame.CanvasSize =
        UDim2.new(
            0,
            0,
            0,
            visibleCount * 37 + 5
        )

    if #suggestions > 0 then

        statusLabel.Text =
            "found "
            .. #suggestions
            .. " suggestions"

    else

        statusLabel.Text =
            "no words for '"
            .. searchPrefix
            .. "'"
    end

    wordCountLabel.Text =
        #filteredDictionary
        .. " words"
end

--========================================================--
-- GAME DETECTION
--========================================================--

local function SetupTriggers()

    local inGameGui =
        parent:FindFirstChild(
            "InGame"
        )

    if not inGameGui then

        parent.ChildAdded:Connect(
            function(child)

                if child.Name ==
                    "InGame" then

                    task.wait(0.2)

                    SetupTriggers()
                end
            end
        )

        return
    end

    timeCounterRunning = true

    local frame =
        inGameGui:FindFirstChild(
            "Frame"
        )

    if not frame then
        return
    end

    local wordFrame =
        frame:FindFirstChild(
            "CurrentWord"
        )

    if wordFrame then

        wordFrame.ChildAdded:Connect(
            function()

                task.wait(0.03)

                if isInitialized then
                    UpdateSuggestions()
                end
            end
        )

        wordFrame.ChildRemoved:Connect(
            function()

                task.wait(0.03)

                if isInitialized then
                    UpdateSuggestions()
                end
            end
        )
    end

    local box =
        frame:FindFirstChild("TextBox")
        or frame:FindFirstChild("AnswerBox")
        or frame:FindFirstChild("ChatInput")

    if box
        and box:IsA("TextBox") then

        box:GetPropertyChangedSignal(
            "Text"
        ):Connect(
            function()

                if isInitialized then
                    UpdateSuggestions()
                end
            end
        )
    end

