local function EscapeRichText(text)
    text = text:gsub("&", "&amp;")
    text = text:gsub("<", "&lt;")
    text = text:gsub(">", "&gt;")

    return text
end

local function FormatSuggestionText(word, prefix)
    local lowerWord = word:lower()
    local lowerPrefix = tostring(prefix or ""):lower()

    local used = usedWords[lowerWord]
    local favorite = favoriteWords[lowerWord]
    local killer = IsKillerWord(lowerWord)

    local displayWord = EscapeRichText(word)

    if lowerPrefix ~= ""
        and lowerWord:sub(1, #lowerPrefix) == lowerPrefix
    then
        local typed = EscapeRichText(
            word:sub(1, #lowerPrefix)
        )

        local remaining = EscapeRichText(
            word:sub(#lowerPrefix + 1)
        )

        local typedColor = "#E8E8EC"

        if used then
            typedColor = "#77777E"
        end

        local result =
            '<font color="' ..
            typedColor ..
            '">' ..
            typed ..
            "</font>" ..
            remaining

        if favorite then
            result =
                '<font color="#F2F2F5">★</font> ' ..
                result
        elseif killer then
            result =
                '<font color="#AFAFB6">◆</font> ' ..
                result
        end

        return result
    end

    if used then
        return '<font color="#77777E">' ..
            displayWord ..
            "</font>"
    end

    return displayWord
end

