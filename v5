local function GetTypingDelay()
    local wpm = math.clamp(tonumber(settings.wpm) or 300, 20, 700)

    local lettersPerSecond = (wpm * 5) / 60

    if lettersPerSecond <= 0 then
        return 0.05
    end

    return 1 / lettersPerSecond
end

local function HumanDelay()
    if not settings.humanMode then
        return
    end

    local baseDelay = GetTypingDelay()

    local variance = baseDelay * (
        math.random(-30, 30) / 100
    )

    local delay = math.max(
        0.008,
        baseDelay + variance
    )

    task.wait(delay)
end

local function SimulateTypo(word)
    if not settings.riskyMistakes then
        if math.random(1, 100) > settings.mistakeChance then
            return nil
        end
    else
        if math.random(1, 100) > settings.mistakeChance * 1.5 then
            return nil
        end
    end

    if #word < 4 then
        return nil
    end

    local position = math.random(1, #word)

    local current = word:sub(position, position)

    local wrong = current

    local attempts = 0

    while wrong == current and attempts < 10 do
        wrong = string.char(math.random(97, 122))
        attempts += 1
    end

    return {
        position = position,
        wrongLetter = wrong,
        correctLetter = current
    }
end

local function FindInputBox()
    local inGameGui = PlayerGui:FindFirstChild("InGame")

    if not inGameGui then
        return nil
    end

    local frame = inGameGui:FindFirstChild("Frame")

    if not frame then
        return nil
    end

    local names = {
        "TextBox",
        "AnswerBox",
        "Input",
        "ChatInput",
        "Answer",
        "WordInput"
    }

    for _, name in ipairs(names) do
        local object = frame:FindFirstChild(name)

        if object and object:IsA("TextBox") then
            return object
        end
    end

    for _, descendant in ipairs(frame:GetDescendants()) do
        if descendant:IsA("TextBox") then
            return descendant
        end
    end

    return nil
end

local function PressEnter()
    pcall(function()
        VirtualInputManager:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.025)

        VirtualInputManager:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )
    end)
end

local function TypeViaKeys(word)
    for i = 1, #word do
        local char = word:sub(i, i):lower()

        local keyCode = Enum.KeyCode[char:upper()]

        if keyCode then
            VirtualInputManager:SendKeyEvent(
                keyCode,
                true,
                false
            )

            if settings.humanMode then
                HumanDelay()
            else
                task.wait(settings.blatant and 0.004 or 0.009)
            end

            VirtualInputManager:SendKeyEvent(
                keyCode,
                false,
                false
            )

            if settings.humanMode and i < #word then
                HumanDelay()
            end
        end
    end

    task.wait(
        settings.humanMode
        and math.min(GetTypingDelay() * 0.6, 0.15)
        or 0.02
    )

    PressEnter()
end

local function TypeWordHuman(word)
    local box = FindInputBox()

    if not box then
        TypeViaKeys(word)
        return
    end

    box:CaptureFocus()

    task.wait(0.035)

    box.Text = ""

    local typo = SimulateTypo(word)

    for i = 1, #word do
        local char = word:sub(i, i)

        if typo and typo.position == i then
            box.Text ..= typo.wrongLetter

            HumanDelay()

            task.wait(
                math.min(
                    GetTypingDelay() * 0.35,
                    0.08
                )
            )

            VirtualInputManager:SendKeyEvent(
                Enum.KeyCode.Backspace,
                true,
                false
            )

            task.wait(0.025)

            VirtualInputManager:SendKeyEvent(
                Enum.KeyCode.Backspace,
                false,
                false
            )

            HumanDelay()

            box.Text ..= typo.correctLetter
        else
            box.Text ..= char
        end

        HumanDelay()
    end

    task.wait(
        math.min(
            GetTypingDelay() * 0.5,
            0.12
        )
    )

    PressEnter()

    task.wait(0.035)

    pcall(function()
        box:ReleaseFocus()
    end)
end

local function TypeWordFast(word)
    local box = FindInputBox()

    if box then
        box:CaptureFocus()

        task.wait(0.02)

        box.Text = word

        task.wait(
            settings.blatant
            and 0.003
            or 0.012
        )

        PressEnter()

        task.wait(0.02)

        pcall(function()
            box:ReleaseFocus()
        end)

        return
    end

    TypeViaKeys(word)
end

