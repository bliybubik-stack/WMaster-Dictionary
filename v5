local function GetTypingDelay()
    local wpm = math.clamp(settings.wpm, 50, 700)

    local lettersPerSecond =
        (wpm * 5) / 60

    local baseDelay =
        1 / lettersPerSecond

    return baseDelay * 1000
end

local function HumanDelay(multiplier)
    if not settings.humanMode then
        return
    end

    local baseDelay = GetTypingDelay()

    local variance =
        baseDelay *
        (math.random(-35, 35) / 100)

    local actualDelay =
        math.max(
            8,
            (baseDelay + variance) *
            (multiplier or 1)
        )

    task.wait(actualDelay / 1000)
end

local function GetInputBox()
    local inGameGui = PlayerGui:FindFirstChild("InGame")

    if not inGameGui then
        return nil
    end

    local frame =
        inGameGui:FindFirstChild("Frame")

    if not frame then
        return nil
    end

    local possibleNames = {
        "TextBox",
        "AnswerBox",
        "Input",
        "ChatInput"
    }

    for _, name in ipairs(possibleNames) do
        local object = frame:FindFirstChild(name)

        if object and object:IsA("TextBox") then
            return object
        end
    end

    return nil
end

local function SimulateTypo(word)
    if not settings.humanMode then
        return nil
    end

    if settings.riskyMistakes then
        if math.random(1, 100) >
            settings.mistakeChance * 1.5 then
            return nil
        end
    else
        if math.random(1, 100) >
            settings.mistakeChance then
            return nil
        end
    end

    if #word < 4 then
        return nil
    end

    local position =
        math.random(1, #word)

    local original =
        string.sub(word, position, position)

    local wrongLetter

    repeat
        wrongLetter =
            string.char(
                math.random(97, 122)
            )
    until wrongLetter ~= original

    return {
        position = position,
        wrongLetter = wrongLetter,
        correctLetter = original
    }
end

