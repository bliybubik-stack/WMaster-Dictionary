--==================================================
-- FETCH DICTIONARIES
--==================================================

local function SaveFile(content)
    if not writefile then
        return false
    end

    local ok = pcall(function()
        writefile(FILE_NAME, content)
    end)

    return ok
end

local function LoadFile()
    if not isfile or not readfile then
        return nil
    end

    local ok, content = pcall(function()
        if isfile(FILE_NAME) then
            return readfile(FILE_NAME)
        end

        return nil
    end)

    if ok then
        return content
    end

    return nil
end

local function ParseText(content)
    if not content then
        return 0
    end

    local added = 0

    for line in content:gmatch("[^\r\n]+") do
        local word = line
            :lower()
            :gsub("[%s%c]+", "")

        if word:match("^[a-z]+$")
            and #word >= MIN_LENGTH
            and #word <= MAX_LENGTH
            and not Seen[word]
        then
            Seen[word] = true
            table.insert(Words, word)
            added += 1
        end
    end

    return added
end

local function DownloadDictionaries()
    local combined = {}
    local combinedSeen = {}

    -- Load the exact local file first.
    local localFile = LoadFile()

    if localFile then
        SetLoading(
            "Loading " .. FILE_NAME .. "...",
            Theme.Accent
        )

        for line in localFile:gmatch("[^\r\n]+") do
            local word = line
                :lower()
                :gsub("[%s%c]+", "")

            if word:match("^[a-z]+$")
                and #word >= MIN_LENGTH
                and #word <= MAX_LENGTH
                and not combinedSeen[word]
            then
                combinedSeen[word] = true
                table.insert(combined, word)
            end
        end
    end

    -- Fetch the two libraries.
    for index, dictionary in ipairs(DICTIONARIES) do
        SetLoading(
            "Fetching library " .. index .. "/2\n" .. dictionary.Name,
            Theme.Accent
        )

        local content = HTTPGet(dictionary.URL)

        if content then
            local added = 0

            for line in content:gmatch("[^\r\n]+") do
                local word = line
                    :lower()
                    :gsub("[%s%c]+", "")

                if word:match("^[a-z]+$")
                    and #word >= MIN_LENGTH
                    and #word <= MAX_LENGTH
                    and not combinedSeen[word]
                then
                    combinedSeen[word] = true
                    table.insert(combined, word)
                    added += 1
                end
            end

            SetLoading(
                dictionary.Name .. ": +" .. added .. " words",
                Theme.Success
            )
        else
            SetLoading(
                dictionary.Name .. ": download failed",
                Theme.Error
            )
        end
    end

    -- Rebuild the exact file with the merged result.
    table.sort(combined)

    local output = table.concat(combined, "\n")

    if #output > 0 then
        SaveFile(output)
    end

    Words = combined
    Seen = {}

    for _, word in ipairs(Words) do
        Seen[word] = true
    end

    return #Words
end

--==================================================
-- WORD INDEX
--==================================================

local function BuildIndex()
    table.sort(Words)

    PrefixCache = {}

    -- Pre-create first-letter buckets.
    local Buckets = {}

    for i, word in ipairs(Words) do
        local first = word:sub(1, 1)

        if not Buckets[first] then
            Buckets[first] = {}
        end

        table.insert(Buckets[first], i)
    end

    return Buckets
end

local Buckets = {}

local function FindRange(prefix)
    prefix = prefix:lower()

    if #prefix == 0 then
        return nil, nil
    end

    local first = prefix:sub(1, 1)

    local bucket = Buckets[first]

    if not bucket or #bucket == 0 then
        return nil, nil
    end

    local low = 1
    local high = #bucket
    local startPosition = nil

    while low <= high do
        local middle = math.floor((low + high) / 2)
        local word = Words[bucket[middle]]

        if word < prefix then
            low = middle + 1
        else
            startPosition = middle
            high = middle - 1
        end
    end

    if not startPosition then
        return nil, nil
    end

    local startIndex = bucket[startPosition]

    if not Words[startIndex]:sub(1, #prefix) == prefix then
        if Words[startIndex]:sub(1, #prefix) ~= prefix then
            return nil, nil
        end
    end

    low = startPosition
    high = #bucket

    local endPosition = startPosition - 1

    while low <= high do
        local middle = math.floor((low + high) / 2)
        local word = Words[bucket[middle]]

        if word:sub(1, #prefix) == prefix then
            endPosition = middle
            low = middle + 1
        else
            high = middle - 1
        end
    end

    if endPosition < startPosition then
        return nil, nil
    end

    return bucket[startPosition], bucket[endPosition]
end

--==================================================
-- SUGGESTION LOGIC
--==================================================

local function GetSuggestions(prefix)
    prefix = tostring(prefix or ""):lower()

    if prefix == "" then
        return {}
    end

    if PrefixCache[prefix] then
        return PrefixCache[prefix]
    end

    local startIndex, endIndex = FindRange(prefix)

    if not startIndex then
        PrefixCache[prefix] = {}
        return {}
    end

    local results = {}

    local maximumScan = math.min(
        endIndex,
        startIndex + 100
    )

    for i = startIndex, maximumScan do
        local word = Words[i]

        if word
            and word ~= prefix
            and #word >= MIN_LENGTH
            and #word <= MAX_LENGTH
            and word:match("^[a-z]+$")
            and not UsedWords[word]
        then
            table.insert(results, word)

            if #results >= SUGGESTION_COUNT then
                break
            end
        end
    end

    PrefixCache[prefix] = results

    return results
end

local function ResetUsed()
    UsedWords = {}
    PrefixCache = {}
end

