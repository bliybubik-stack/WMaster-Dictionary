    isInitialized = true

    return totalWords
end

--========================================================--
-- AUTO PLAY
--========================================================--

local function AutoPlayLoop()
    while isAutoPlaying
        and isInitialized do

        task.wait(
            settings.autoPlayDelay
        )

        if not isAutoPlaying then
            break
        end

        local requiredLetter =
            GetRequiredLetter()

        local currentWord =
            GetCurrentWord()

        local searchPrefix = ""

        if currentWord
            and #currentWord > 0 then

            searchPrefix =
                currentWord

        elseif requiredLetter
            and #requiredLetter > 0 then

            searchPrefix =
                requiredLetter
        else
            continue
        end

        local suggestions =
            GetSuggestions(
                searchPrefix
            )

        if #suggestions > 0 then
            local word

            if settings.randomSuggestions then
                word =
                    suggestions[
                        math.random(
                            1,
                            #suggestions
                        )
                    ]
            else
                word = suggestions[1]
            end

            if word then
                TypeWord(word)
            end
        end
    end
end

