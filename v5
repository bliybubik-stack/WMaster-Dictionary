--//========================================================

local function IsKillerWord(word)
    local lowerWord =
        word:lower()

    for _, ending in ipairs(hardEndings) do
        if #ending <= #lowerWord then
            if string.sub(
                lowerWord,
                -#ending
            ) == ending then
                return true
            end
        end
    end

    return false
end

local function GetKillerScore(word)
    local score = 0

    local lower = word:lower()

    for _, ending in ipairs(hardEndings) do
        if lower:sub(-#ending) == ending then
            score += #ending * 10
        end
    end

    score += math.min(#word, 20)

    return score
end

--//========================================================
--// SUGGESTION LOGIC
--//========================================================

-- IMPORTANT:
-- This section intentionally preserves the original
-- prefix/suggestion logic.

local function FilterWordsByMode()
    local filtered = {}

    local minLen =
        settings.minWordLength or 3

    local maxLen =
        settings.maxWordLength or 20

    for _, word in ipairs(dictionary) do
        local wordLen = #word

        if wordLen >= minLen
            and wordLen <= maxLen then

            if not usedWords[word]
                or settings.showUsedWords then

                if settings.wordFilter == "all" then
                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "short"
                    and wordLen >= 3
                    and wordLen <= 5 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "middle"
                    and wordLen >= 6
                    and wordLen <= 9 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "long"
                    and wordLen >= 10
                    and wordLen <= 20 then

                    table.insert(
                        filtered,
                        word
                    )

                elseif settings.wordFilter == "killer"
                    and IsKillerWord(word)
                    and wordLen >= 3 then

                    table.insert(
                        filtered,
                        word
                    )
                end
            end
        end
    end

    if settings.priorityMode == "speed" then
        table.sort(
            filtered,
            function(a, b)
                if #a == #b then
                    return a < b
                end

                return #a < #b
            end
        )

    elseif settings.priorityMode == "killer" then
        table.sort(
            filtered,
            function(a, b)
                local scoreA =
                    IsKillerWord(a)
                    and 1
                    or 0

                local scoreB =
                    IsKillerWord(b)
                    and 1
                    or 0

                if scoreA == scoreB then
                    return a < b
                end

                return scoreA > scoreB
            end
        )
    end

    return filtered
end

local UpdateSuggestions

local function UpdateFilteredDictionary()
    filteredDictionary =
        FilterWordsByMode()

    prefixCache = {}

    if isInitialized
        and UpdateSuggestions then

        UpdateSuggestions()
    end
end

local function FindWordRange(prefix)
    local low = 1
    local high = #filteredDictionary

    local startIdx
    local endIdx

    while low <= high do
        local mid =
            math.floor(
                (low + high) / 2
            )

        if filteredDictionary[mid]
            :sub(1, #prefix)
            < prefix then

            low = mid + 1
        else
            high = mid - 1
        end
    end

    startIdx = low

    low = startIdx
    high = #filteredDictionary

    while low <= high do
        local mid =
            math.floor(
                (low + high) / 2
            )

        if filteredDictionary[mid]
            :sub(1, #prefix)
            == prefix then

            low = mid + 1
        else
            high = mid - 1
        end
    end

    endIdx = high

    if startIdx > endIdx then
        return nil, nil
    end

    return startIdx, endIdx
end

local function GetSuggestions(prefix)
    prefix = prefix:lower()

    if #prefix == 0 then
        return {}
    end

    local suggestions = {}

    local range =
        prefixCache[prefix]

    local sIdx
    local eIdx

    if range then
        sIdx = range[1]
        eIdx = range[2]
    else
        sIdx, eIdx =
            FindWordRange(prefix)

        if sIdx then
            prefixCache[prefix] = {
                sIdx,
                eIdx
            }

            local cacheCount = 0

            for _ in pairs(prefixCache) do
                cacheCount += 1

                if cacheCount > 100 then
                    prefixCache = {}
                    break
                end
            end
        end
    end

    if not sIdx then
        return {}
    end

    for i = sIdx,
        math.min(
            sIdx + SUGGESTION_COUNT * 3,
            eIdx
        ) do

        local word =
            filteredDictionary[i]

        if word
            and #suggestions <
                SUGGESTION_COUNT
            and word ~= prefix then

            if word:match(
                "^[a-z]+$"
            )
            and #word >= 3 then

                if not usedWords[word]
                    or settings.showUsedWords then

                    table.insert(
                        suggestions,
                        word
                    )
                end
            end
        end
    end

    return suggestions
end

