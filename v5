local hardEndings = {
    "x", "z", "q", "j", "v", "c", "k", "y",
    "ng", "nk", "mp", "nd", "nt",
    "sk", "sp", "st",
    "ck", "zz", "xx",
    "qu", "gy", "py", "my", "by",
    "pt", "ft", "ld", "lf", "rk",
    "rm", "rn", "rd", "rt", "rs",
    "ths", "ght", "gue", "que"
}

local function IsKillerWord(word)
    word = word:lower()

    for _, ending in ipairs(hardEndings) do
        if #ending <= #word then
            if word:sub(-#ending) == ending then
                return true
            end
        end
    end

    return false
end

local function KillerScore(word)
    local score = 0

    if IsKillerWord(word) then
        score += 100
    end

    local last = word:sub(-1)

    if last == "x" or last == "z" or last == "q" then
        score += 80
    elseif last == "j" or last == "v" then
        score += 60
    elseif last == "k" or last == "y" then
        score += 35
    end

    score += math.min(#word, 20)

    return score
end

