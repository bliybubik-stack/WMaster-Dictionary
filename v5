local function TypeWordHuman(word)
    local inGameGui = parent:FindFirstChild("InGame")

    if not inGameGui then
        return
    end

    local frame = inGameGui:FindFirstChild("Frame")

    if not frame then
        return
    end

    local answerBox = GetAnswerBox()

    if not answerBox then
        for i = 1, #word do
            local char = string.sub(
                word,
                i,
                i
            ):lower()

            local keyCode =
                Enum.KeyCode[char:upper()]

            if keyCode then
                VirtualInput:SendKeyEvent(
                    keyCode,
                    true,
                    false
                )

                HumanDelay()

                VirtualInput:SendKeyEvent(
                    keyCode,
                    false,
                    false
                )

                if i < #word then
                    HumanDelay()
                end
            end
        end

        task.wait(0.05)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )

        return
    end

    answerBox:CaptureFocus()

    task.wait(0.05)

    answerBox.Text = ""

    task.wait(0.05)

    local typo = SimulateTypo(word)

    for i = 1, #word do
        local char = string.sub(
            word,
            i,
            i
        )

        if typo and typo.position == i then
            answerBox.Text =
                answerBox.Text
                .. typo.wrongLetter

            HumanDelay()

            task.wait(
                GetTypingDelay() / 1000 * 0.4
            )

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                true,
                false
            )

            task.wait(0.04)

            VirtualInput:SendKeyEvent(
                Enum.KeyCode.Backspace,
                false,
                false
            )

            HumanDelay()

            answerBox.Text =
                answerBox.Text
                .. typo.correctLetter

            typoWords += 1
        else
            answerBox.Text =
                answerBox.Text
                .. char
        end

        HumanDelay()
    end

    task.wait(
        GetTypingDelay() / 1000 * 0.6
    )

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        true,
        false
    )

    task.wait(0.03)

    VirtualInput:SendKeyEvent(
        Enum.KeyCode.Return,
        false,
        false
    )

    task.wait(0.03)

    answerBox:ReleaseFocus()
end

local function TypeWordFast(word)
    local inGameGui = parent:FindFirstChild("InGame")

    if not inGameGui then
        return
    end

    local frame = inGameGui:FindFirstChild("Frame")

    if not frame then
        return
    end

    local answerBox = GetAnswerBox()

    if answerBox then
        answerBox:CaptureFocus()

        task.wait(0.03)

        answerBox.Text = word

        task.wait(0.03)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )

        answerBox:ReleaseFocus()
    else
        for i = 1, #word do
            local char =
                string.sub(
                    word,
                    i,
                    i
                ):lower()

            local keyCode =
                Enum.KeyCode[char:upper()]

            if keyCode then
                VirtualInput:SendKeyEvent(
                    keyCode,
                    true,
                    false
                )

                if settings.blatant then
                    task.wait(0.005)
                else
                    task.wait(0.008)
                end

                VirtualInput:SendKeyEvent(
                    keyCode,
                    false,
                    false
                )
            end
        end

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            true,
            false
        )

        task.wait(0.02)

        VirtualInput:SendKeyEvent(
            Enum.KeyCode.Return,
            false,
            false
        )
    end
end

local function TypeWord(word)
    if not word or word == "" then
        return
    end

    if settings.humanMode then
        TypeWordHuman(word)
    else
        TypeWordFast(word)
    end

    usedWords[word:lower()] = true

    wordsTyped += 1
    correctWords += 1

    if isAutoPlaying then
        autoWords += 1
    end

    UpdateFilteredDictionary()

    if UpdateSuggestions then
        UpdateSuggestions()
    end
end

