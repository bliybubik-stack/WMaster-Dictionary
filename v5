--//==============================================================
--// UPDATE SUGGESTIONS
--//==============================================================

UpdateSuggestions = function()
    if isDestroyed then
        return
    end

    if not GUI.Suggestions then
        return
    end

    if not isInitialized then
        if GUI.Status then
            GUI.Status.Text =
                "● LOADING DICTIONARY"
        end

        return
    end

    local searchBox =
        GUI.SearchBox

    -- Search box takes priority only while user is typing.
    local searchText = ""

    if searchBox then
        searchText =
            searchBox.Text
                :lower()
                :gsub(
                    "[^a-z]",
                    ""
                )
    end

    local required =
        GetRequiredLetter()

    local current =
        GetCurrentWord()

    local prefix = ""

    if searchText ~= "" then
        prefix = searchText
    elseif current and #current > 0 then
        prefix = current
    elseif required and #required > 0 then
        prefix = required
    end

    currentPrefix = prefix
    currentRequiredLetter =
        required or ""

    if GUI.Prefix then
        if prefix ~= "" then
            GUI.Prefix.Text =
                '"' .. prefix .. '"'
        else
            GUI.Prefix.Text =
                "waiting..."
        end
    end

    if prefix == "" then
        for _, button in ipairs(
            GUI.SuggestionButtons
        ) do
            button.Visible = false
            button:SetAttribute(
                "Word",
                nil
            )
        end

        if GUI.Status then
            GUI.Status.Text =
                "● WAITING FOR WORD"
        end

        if GUI.WordCount then
            GUI.WordCount.Text =
                tostring(
                    #filteredDictionary
                ) ..
                " words"
        end

        return
    end

    if prefix ~= lastDetectedPrefix
        or required ~= lastRequiredLetter
    then
        lastDetectedPrefix = prefix
        lastRequiredLetter =
            required
    end

    local suggestions =
        GetSuggestions(prefix)

    local visibleCount = 0

    for i, button in ipairs(
        GUI.SuggestionButtons
    ) do
        local word =
            suggestions[i]

        if word then
            local formatted =
                FormatSuggestionText(
                    word,
                    prefix
                )

            button.Visible = true

            button:SetAttribute(
                "Word",
                word
            )

            button.Text =
                "    " .. formatted

            visibleCount += 1
        else
            button.Visible = false

            button:SetAttribute(
                "Word",
                nil
            )
        end
    end

    GUI.Suggestions.CanvasSize =
        UDim2.new(
            0,
            0,
            0,
            visibleCount * 33
        )

    if #suggestions > 0 then
        GUI.Status.Text =
            "● " ..
            tostring(#suggestions) ..
            " SUGGESTIONS"
    else
        GUI.Status.Text =
            "● NO UNUSED MATCHES"
    end

    GUI.WordCount.Text =
        tostring(#filteredDictionary) ..
        " words"
end

--//==============================================================
// UPDATE QUEUE
//==============================================================

QueueSuggestionUpdate = function(delayTime)
    if refreshQueued then
        return
    end

    refreshQueued = true

    task.delay(
        delayTime or CONFIG.EventRefreshDelay,
        function()
            refreshQueued = false

            if not isDestroyed then
                UpdateSuggestions()
            end
        end
    )
end

--//==============================================================
// GAME EVENT WATCHERS
//==============================================================

local function ConnectGameEvents()
    local inGame =
        FindInGame()

    if not inGame then
        return
    end

    local frame =
        inGame:FindFirstChild("Frame")

    if not frame then
        return
    end

    timeCounterRunning = true

    local currentWord =
        frame:FindFirstChild(
            "CurrentWord"
        )

    if currentWord then
        currentWord.ChildAdded:Connect(
            function()
                QueueSuggestionUpdate(
                    CONFIG.EventRefreshDelay
                )
            end
        )

        currentWord.ChildRemoved:Connect(
            function()
                QueueSuggestionUpdate(
                    CONFIG.EventRefreshDelay
                )
            end
        )
    end

    local box =
        FindInputBox()

    if box then
        box:GetPropertyChangedSignal(
            "Text"
        ):Connect(function()
            QueueSuggestionUpdate(0)
        end)
    end

    frame.DescendantAdded:Connect(
        function(object)
            if object:IsA("TextLabel")
                or object:IsA("TextBox")
            then
                QueueSuggestionUpdate(
                    CONFIG.EventRefreshDelay
                )
            end
        end
    )

    frame.DescendantRemoving:Connect(
        function()
            QueueSuggestionUpdate(
                CONFIG.EventRefreshDelay
            )
        end
    )

    task.delay(
        0.1,
        function()
            QueueSuggestionUpdate(0)
        end
    )
end

