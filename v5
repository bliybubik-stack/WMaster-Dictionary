--==================================================
-- UPDATE SUGGESTIONS
--==================================================

function UpdateSuggestions(prefix)
    if not Initialized then
        return
    end

    prefix = tostring(prefix or ""):lower()
    prefix = prefix:gsub("[^a-z]", "")

    CurrentPrefix = prefix

    PrefixValue.Text = prefix ~= "" and '"' .. prefix .. '"' or "---"

    for _, item in ipairs(Buttons) do
        item.Button.Visible = false
        item.Word = ""
        item.Label.Text = ""
    end

    if prefix == "" then
        Status.Text = "Type a prefix"
        Status.TextColor3 = Theme.Muted
        return
    end

    local results = GetSuggestions(prefix)

    for i, word in ipairs(results) do
        if Buttons[i] then
            Buttons[i].Word = word

            local prefixPart = word:sub(1, #prefix)
            local remaining = word:sub(#prefix + 1)

            Buttons[i].Label.Text =
                prefixPart .. remaining

            Buttons[i].Button.Visible = true
        end
    end

    Suggestions.CanvasSize = UDim2.new(
        0,
        0,
        0,
        math.max(0, #results * 31)
    )

    if #results > 0 then
        Status.Text = "Found " .. #results .. " suggestions"
        Status.TextColor3 = Theme.Success
    else
        Status.Text = "No words found"
        Status.TextColor3 = Theme.Error
    end
end

Input:GetPropertyChangedSignal("Text"):Connect(function()
    local text = Input.Text:lower()
    text = text:gsub("[^a-z]", "")

    if Input.Text ~= text then
        Input.Text = text
    end

    UpdateSuggestions(text)
end)

