    local function CreateToggle(
        row,
        initial,
        callback
    )
        local button =
            CreateButton(
                row,
                initial and "ON" or "OFF",
                UDim2.new(
                    0,
                    55,
                    0,
                    25
                ),
                UDim2.new(
                    1,
                    -65,
                    0,
                    9
                )
            )

        local function refresh()
            button.Text =
                initial
                and "ON"
                or "OFF"

            button.TextColor3 =
                initial
                and COLORS.success
                or COLORS.gray
        end

        refresh()

        button.MouseButton1Click:Connect(
            function()
                initial = not initial
                refresh()

                if callback then
                    callback(initial)
                end
            end
        )

        return button
    end

    local function CreateNumber(
        row,
        value,
        min,
        max,
        callback
    )
        local box =
            CreateInput(
                row,
                tostring(value),
                UDim2.new(
                    0,
                    70,
                    0,
                    25
                ),
                UDim2.new(
                    1,
                    -80,
                    0,
                    9
                )
            )

        box.FocusLost:Connect(
            function()
                local number =
                    tonumber(box.Text)

                if number then
                    number =
                        math.clamp(
                            number,
                            min,
                            max
                        )

                    box.Text =
                        tostring(number)

                    if callback then
                        callback(number)
                    end
                else
                    box.Text =
                        tostring(value)
                end
            end
        )

        return box
    end

    local function CreateCycle(
        row,
        values,
        current,
        callback
    )
        local index = 1

        for i, value in ipairs(values) do
            if value == current then
                index = i
                break
            end
        end

        local button =
            CreateButton(
                row,
                tostring(
                    values[index]
                ):upper(),
                UDim2.new(
                    0,
                    92,
                    0,
                    25
                ),
                UDim2.new(
                    1,
                    -102,
                    0,
                    9
                )
            )

        button.MouseButton1Click:Connect(
            function()
                index =
                    index % #values + 1

                local value =
                    values[index]

                button.Text =
                    tostring(
                        value
                    ):upper()

                if callback then
                    callback(value)
                end
            end
        )

        return button
    end

